---
import Head from '../components/Head.astro';
import Shell from '../components/Shell.astro';
interface Props {
  headExtra?: string;
  bodyStart?: string;
  bodyEnd?: string;
  bodyClass?: string;
  bodyAttrs?: string;
}
const { headExtra = '', bodyStart = '', bodyEnd = '', bodyClass = '', bodyAttrs = '' } = Astro.props;
// Astro escapes script closers inside String.raw source payloads. Decode only
// those closers before inserting this trusted, repository-owned markup.
const rawMarkup = (value: string) => value.replaceAll('<' + String.fromCharCode(92) + '/script>', '</script>');
const extraAttrs: Record<string, string> = {};
for (const m of bodyAttrs.matchAll(/([\w-]+)="([^"]*)"/g)) extraAttrs[m[1]] = m[2];
// The shared shell owns the banner; discard the duplicate from legacy payloads.
const startMarkup = bodyStart.replace(/<aside\b[^>]*class="[^"]*emergency-banner[^"]*"[\s\S]*?<\/aside>/gi, '');
---
<!DOCTYPE html>
<html lang="en-IN" dir="ltr">
<head>
<meta charset="UTF-8">
{headExtra && <Fragment set:html={rawMarkup(headExtra)} />}
<Head />
</head>
<body class={bodyClass || undefined} data-chrome-normalized="true" {...extraAttrs}>
{startMarkup && <Fragment set:html={rawMarkup(startMarkup)} />}
<Shell><slot /></Shell>
{bodyEnd && <Fragment set:html={rawMarkup(bodyEnd)} />}
</body>
</html>
