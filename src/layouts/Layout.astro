---
import Head from '../components/Head.astro';
import Shell from '../components/Shell.astro';
import StructuredData from '../components/StructuredData.astro';
interface Props {
  headExtra?: string;
  bodyStart?: string;
  bodyEnd?: string;
  bodyClass?: string;
  bodyAttrs?: string;
}
const { headExtra = '', bodyStart = '', bodyEnd = '', bodyClass = '', bodyAttrs = '' } = Astro.props;
// Astro escapes script closers inside String.raw source payloads. Decode only
// those closers before inserting this trusted, repository-owned markup.
const rawMarkup = (value: string) => value.replaceAll('<' + String.fromCharCode(92) + '/script>', '</script>');
const canonical = headExtra.match(/<link\s+rel="canonical"\s+href="([^"]+)"/i)?.[1] ?? `https://mindgracencr.in${Astro.url.pathname}`;
const title = headExtra.match(/<title>([\s\S]*?)<\/title>/i)?.[1]?.trim() ?? 'Mind Grace Neuropsychiatric Clinic';
const description = headExtra.match(/<meta\s+name="description"\s+content="([^"]*)"/i)?.[1] ?? '';
// Editorial metadata for the Article node in StructuredData. Pages opt in via
// og:type="article" (and an optional blog-date publication meta). Hub pages
// that aggregate article listings use CollectionPage instead of Article so a
// page never carries two conflicting editorial types.
const canonicalPath = new URL(canonical).pathname.replace(/\/+$/, '') || '/';
const isCollectionHub = canonicalPath === '/aasha/learning';
const isArticlePage = !isCollectionHub && /<meta\s+property="og:type"\s+content="article"/i.test(headExtra);
const articleDate = headExtra.match(/<meta\s+name="blog-date"\s+content="(\d{4}-\d{2}-\d{2})"/i)?.[1];
// Fill missing sharing metadata without replacing each page's own search intent.
const aashaPage = /\/(?:aasha(?:\/|$)|child-development$|child-student-mental-health$|learning-disability-assessment$|sleep-and-autism-guide-indian-parents$|blog\/(?:children$|pages\/child\/))/.test(new URL(canonical).pathname);
const metaValue = (value: string) => value.replaceAll('&amp;', '&').replaceAll('&quot;', '"').replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;');
const socialImage = aashaPage ? 'https://mindgracencr.in/assets/images/Aasha_early_intervention_logo.webp' : 'https://mindgracencr.in/assets/images/mind-grace-entry-n-reception.webp';
const metaDefaults = [
  ['property', 'og:title', title], ['property', 'og:description', description],
  ['property', 'og:url', canonical], ['property', 'og:type', 'website'],
  ['property', 'og:site_name', aashaPage ? 'Aasha Early Intervention Centre' : 'Mind Grace Neuropsychiatric Clinic'],
  ['property', 'og:image', socialImage], ['property', 'og:image:alt', aashaPage ? 'Aasha Early Intervention Centre' : 'Mind Grace Neuropsychiatric Clinic'],
  ['name', 'twitter:card', 'summary_large_image'], ['name', 'twitter:title', title],
  ['name', 'twitter:description', description], ['name', 'twitter:image', socialImage],
];
const socialMeta = metaDefaults.filter(([attribute, key]) => !headExtra.includes(`${attribute}="${key}"`) && !headExtra.includes(`${attribute}='${key}'`)).map(([attribute, key, value]) => `<meta ${attribute}="${key}" content="${metaValue(value)}">`).join('');
const extraAttrs: Record<string, string> = {};
for (const m of bodyAttrs.matchAll(/([\w-]+)="([^"]*)"/g)) extraAttrs[m[1]] = m[2];
// The shared shell owns the banner; discard the duplicate from legacy payloads.
let startMarkup = bodyStart.replace(/<aside\b[^>]*class="[^"]*emergency-banner[^"]*"[\s\S]*?<\/aside>/gi, '');
// Recursive chrome cleanup: Shell.astro already ships the canonical header,
// footer and mobile navigation (the runtime enhancer in
// assets/js/visitor-friendly.js also removes any un-tagged duplicates it finds
// at load time, but pages must be correct without JavaScript too). Strip the
// stale per-page copies — mobile nav overlays/panels with their section lists,
// legacy burger dropdowns, orphaned burger buttons, leftover chrome comments
// and progress bars — from every page that renders through this layout, so no
// route can ship a second, un-styled (distorted, "un-collapsed") menu.
const stripChrome = (markup: string) => markup
  // HTML comment markers left behind by the old hand-authored chrome.
  .replace(/<!--\s*(?:MOBILE NAV(?: OVERLAY| PANEL[^-]*)?|Simplified)[^>]*-->\s*/gi, '')
  .replace(/<!--\s*(?:EMERGENCY BANNER[^>]*|Header|Network Status Toast|Scroll Progress Bar|Ambient Background|Library Stack)[^>]*-->\s*/gi, '')
  // Legacy mobile nav overlay + panel (with its full section lists).
  .replace(/<div\b[^>]*class="[^"]*\bmobile-nav-overlay\b[^"]*"(?:[^>]*>[^<]*<\/div>)?\s*/gi, '')
  .replace(/<nav\b[^>]*class="[^"]*\bmobile-nav-panel\b[^"]*"[\s\S]*?<\/nav>\s*/gi, '')
  // Legacy burger dropdown menus and the burger buttons that opened them.
  .replace(/<div\b[^>]*class="[^"]*\bnav-dropdown\b[^"]*"[\s\S]*?<\/div>\s*/gi, '')
  .replace(/<button\b[^>]*class="[^"]*\bburger-btn\b[^"]*"[\s\S]*?<\/button>\s*/gi, '')
  // FIX (dropdown menu bar): also strip whole legacy dropdown wrappers whose
  // *inner* div carries nav-dropdown (older payloads nest it inside a wrapper)
  // and any orphaned desktop-nav / funnel fragments — the shared Shell renders
  // exactly one canonical menu, so a second copy is what made headers look
  // "distorted / un-collapsed" on pages like /book before visitor-friendly.js
  // could de-duplicate them at runtime.
  .replace(/<div\b(?![^>]*class)[^>]*>\s*<div\b[^>]*class="[^"]*\bnav-dropdown\b[^"]*"[\s\S]*?<\/div>\s*<\/div>\s*/gi, '')
  .replace(/<nav\b[^>]*class="[^"]*\bdesktop-nav\b[^"]*"[\s\S]*?<\/nav>\s*/gi, '')
  .replace(/<li\b[^>]*class="[^"]*\bnav-funnel\b[^"]*"[\s\S]*?<\/li>\s*/gi, '')
  // Duplicated scroll-progress bars (the shared shell owns scroll UI).
  .replace(/<div\b[^>]*class="[^"]*\b(?:scroll-progress|progress-bar)\b[^"]*"[^>]*>\s*<\/div>\s*/gi, '');
startMarkup = stripChrome(startMarkup);
// Pages whose entire document was captured as a bodyStart payload (legacy
// migration artifacts) can carry a complete duplicate <head>, doctype or even
// a nested <html> — drop everything before <body> and keep only the document
// body content, which the Shell re-wraps with the canonical chrome.
if (/<(!doctype\s+html|html\b)/i.test(startMarkup)) {
  const bodyOpen = startMarkup.match(/<body\b[^>]*>/i);
  if (bodyOpen && bodyOpen.index !== undefined) {
    const tail = startMarkup.slice(bodyOpen.index + bodyOpen[0].length);
    const bodyClose = tail.search(/<\/body>/i);
    startMarkup = stripChrome(bodyClose === -1 ? tail : tail.slice(0, bodyClose));
  } else {
    // No <body> marker at all: an unclosed/duplicate head block is dead
    // weight — remove everything up to the first real element after it.
    startMarkup = stripChrome(startMarkup.replace(/^[\s\S]*?(?=<main\b|<div\b|<section\b|<p\b|<h1\b)/i, ''));
  }
}
// The captured payload may still hold a second copy of the shared header or
// footer; keep only occurrences tagged data-shared-shell (there should be
// none — Shell.astro renders exactly one of each).
startMarkup = startMarkup
  .replace(/<(header|footer)\b[^>]*>(?:(?!<\/\1>)[\s\S])*?<\/\1>/gi, (m) => (m.includes('data-shared-shell') ? m : ''))
  .trim();
---
<!DOCTYPE html>
<html lang="en-IN" dir="ltr">
<head>
<meta charset="UTF-8">
{headExtra && <Fragment set:html={rawMarkup(headExtra)} />}
<Fragment set:html={socialMeta} />
<Head />
<StructuredData canonical={canonical} title={title} description={description} isArticle={isArticlePage} articleDate={articleDate} />
</head>
<body class={bodyClass || undefined} data-chrome-normalized="true" {...extraAttrs}>
{startMarkup && <Fragment set:html={rawMarkup(startMarkup)} />}
<Shell><slot /></Shell>
{bodyEnd && <Fragment set:html={rawMarkup(bodyEnd)} />}
</body>
</html>
