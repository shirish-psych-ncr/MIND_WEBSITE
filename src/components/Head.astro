---
/**
 * Shared <head> assets for every Mind Grace route.
 *
 * Mirrors exactly what scripts/normalize_site_shell.py injects into the
 * legacy static pages (theme bootstrap + visitor-friendly + site-foundation),
 * so Astro-rendered routes and any remaining hand-authored routes load the
 * same shell bundle with the same cache-busting versions.
 */
interface Props {
  /** Version tag for the shared foundation bundle (sync with normalize_site_shell.py). */
  version?: string;
}

const { version = 'astro-repair1' } = Astro.props;

const themeInit = `try{const t=localStorage.getItem('mindgrace-theme');document.documentElement.dataset.theme=t==='light'||t==='dark'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}`;
---

<meta name="color-scheme" content="light dark">
<!-- The HTTP CSP is maintained in `/_headers` and `worker.js`. No meta CSP is
     emitted here. Keep any Cloudflare Dashboard header rule in sync. -->
<!-- FIX (Rocket Loader): data-cfasync="false" keeps these critical scripts in
     their declared execution order and prevents Cloudflare Rocket Loader from
     deferring/rewriting them (theme bootstrap runs before paint; translate +
     visitor-friendly own the shell wiring). -->
<script is:inline data-cfasync="false" set:html={themeInit}></script>
<script is:inline data-cfasync="false" src={`/assets/js/min/visitor-friendly.min.js?v=${version}`} defer></script>
<link rel="stylesheet" href={`/assets/css/min/site-foundation.min.css?v=${version}`} data-mindgrace-final-foundation>

<link rel="stylesheet" href="/assets/css/min/translate.min.css?v=astro-repair1">
<script is:inline data-cfasync="false" src="/assets/js/min/translate.min.js?v=astro-repair1" defer></script>
