---
/**
 * Shared <head> assets for every Mind Grace route.
 *
 * Mirrors exactly what scripts/normalize_site_shell.py injects into the
 * legacy static pages (theme bootstrap + visitor-friendly + site-foundation),
 * so Astro-rendered routes and any remaining hand-authored routes load the
 * same shell bundle with the same cache-busting versions.
 */
interface Props {
  /** Version tag for the shared foundation bundle (sync with normalize_site_shell.py). */
  version?: string;
}

const { version = 'responsive18' } = Astro.props;

const themeInit = `try{const t=localStorage.getItem('mindgrace-theme');document.documentElement.dataset.theme=t==='light'||t==='dark'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}`;
---
<meta charset="UTF-8">
<meta name="color-scheme" content="light dark">
<script data-theme-is:inline={themeInit}></script>
<script src={`/assets/js/min/visitor-friendly.min.js?v=${version}`} defer></script>
<link rel="stylesheet" href={`/assets/css/min/site-foundation.min.css?v=${version}`} data-mindgrace-final-foundation>
