---
import {
  CLINIC_ID,
  AASHA_ID,
  aasha,
  PERSON_ID,
  PHYSICIAN_ID,
  SITE_URL,
  WEBSITE_ID,
  clinic,
  clinicAddress,
} from '../config/business';

interface Props {
  canonical: string;
  title: string;
  description: string;
  /** Editorial pages (guides, articles) ship an Article schema node. */
  isArticle?: boolean;
  /** ISO publication date; defaults to the evidence-review date when absent. */
  articleDate?: string;
  /** ISO last substantive edit date; falls back to the publication date. */
  articleModifiedDate?: string;
}

const { canonical, title, description, isArticle = false, articleDate, articleModifiedDate } = Astro.props;
const pageUrl = canonical || `${SITE_URL}${Astro.url.pathname}`;
const aashaId = AASHA_ID;
const isAashaPage = ['/aasha', '/child-development', '/child-student-mental-health', '/learning-disability-assessment', '/sleep-and-autism-guide-indian-parents', '/blog/children'].some(path => pageUrl === `${SITE_URL}${path}`) || pageUrl.includes('/blog/pages/child/') || pageUrl.startsWith(`${SITE_URL}/aasha/`);
const isPhysicianPage = pageUrl === `${SITE_URL}/dr-anita-sharma`;
const publisherId = isAashaPage ? aashaId : CLINIC_ID;
const graph: Record<string, unknown>[] = [
  clinic,
  aasha,
  {
    '@type': 'WebSite',
    '@id': WEBSITE_ID,
    url: `${SITE_URL}/`,
    name: 'Mind Grace Neuropsychiatric Clinic',
    inLanguage: 'en-IN',
    publisher: { '@id': CLINIC_ID },
  },
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: 'en-IN',
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': isAashaPage ? aashaId : isPhysicianPage ? PERSON_ID : CLINIC_ID },
  },
];

if (isPhysicianPage) {
  graph.push({
    '@type': 'ProfilePage',
    '@id': `${pageUrl}#profile`,
    url: pageUrl,
    name: title,
    mainEntity: { '@id': PERSON_ID },
    isPartOf: { '@id': WEBSITE_ID },
    inLanguage: 'en-IN',
  });
}

const servicePages: Record<string, { name: string; provider: string }> = {
  [`${SITE_URL}/psychiatrist-greater-noida`]: { name: 'Psychiatry consultation in Greater Noida', provider: PERSON_ID },
  [`${SITE_URL}/psychiatry`]: { name: 'Psychiatry consultation and follow-up', provider: PERSON_ID },
  [`${SITE_URL}/therapy`]: { name: 'Clinical psychology and therapy', provider: CLINIC_ID },
  [`${SITE_URL}/aasha`]: { name: 'Child development and early intervention', provider: aashaId },
};
if (servicePages[pageUrl]) {
  const service = servicePages[pageUrl];
  graph.push({
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: service.name,
    url: pageUrl,
    provider: { '@id': service.provider },
    areaServed: { '@type': 'City', name: 'Greater Noida' },
    mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  });
}

// The Aasha learning hub is a curated listing of guides, so it ships a
// CollectionPage node (with authorship and review dates) instead of an
// Article node; its per-item BlogPosting/LearningResource markup lives in the
// page's own #content graph.
if (pageUrl === `${SITE_URL}/aasha/learning`) {
  graph.push({
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#collection`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: 'en-IN',
    isPartOf: { '@id': `${pageUrl}#webpage` },
    author: { '@id': aashaId },
    publisher: { '@id': aashaId },
    datePublished: '2026-10-26',
    dateModified: '2026-10-26',
  });
}

// Article markup declares authorship and dates in machine-readable form —
// freshness and attribution signals that search engines and AI tools read.
if (isArticle && !isPhysicianPage) {
  const published = articleDate ?? '2026-10-26';
  graph.push({
    '@type': 'Article',
    '@id': `${pageUrl}#article`,
    headline: title,
    name: title,
    description,
    url: pageUrl,
    mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
    author: { '@id': isAashaPage ? aashaId : PERSON_ID },
    publisher: { '@id': publisherId },
    datePublished: published,
    dateModified: articleModifiedDate ?? published,
    inLanguage: 'en-IN',
    isPartOf: { '@id': `${pageUrl}#webpage` },
  });
}

if (isPhysicianPage || pageUrl === `${SITE_URL}/doctors`) {
  graph.push(
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Dr Anita Sharma',
      jobTitle: 'Consultant Psychiatrist',
      url: `${SITE_URL}/dr-anita-sharma`,
      image: `${SITE_URL}/assets/images/dr-anita-sharma-personal-photo.webp`,
      knowsLanguage: ['English', 'Hindi'],
      worksFor: { '@id': CLINIC_ID },
    },
    {
      '@type': 'Physician',
      '@id': PHYSICIAN_ID,
      name: 'Dr Anita Sharma',
      url: `${SITE_URL}/dr-anita-sharma`,
      image: `${SITE_URL}/assets/images/dr-anita-sharma-personal-photo.webp`,
      telephone: '+91-9667863295',
      priceRange: '₹₹',
      address: clinicAddress,
      medicalSpecialty: 'Psychiatric',
      knowsLanguage: ['English', 'Hindi'],
      parentOrganization: { '@id': CLINIC_ID },
    },
  );
}

const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c');
---
<script id="mindgrace-entity-graph" type="application/ld+json" set:html={json}></script>
