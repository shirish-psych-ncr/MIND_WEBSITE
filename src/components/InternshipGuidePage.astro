---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getInstituteProfile, type InstituteProfile } from '../data/instituteInternships';

interface Props { institution: string; location: string; slug: string; focus?: string; guidance?: string; }
const { institution, location, slug } = Astro.props;
const profile: InstituteProfile | undefined = getInstituteProfile(slug);
const fallbackFocus = profile ? profile.short : 'Its psychology offerings may include clinical, behavioural, and evidence-informed components.';
const fallbackGuidance = profile ? profile.angle : 'Confirm the exact degree, recognition status, required hours, and whether fieldwork is hospital, clinic, laboratory, school, corporate, or community based.';
const title = `${institution} Psychology Internship Guide | Mind Grace`;
const description = `Psychology internship guide for ${institution} students: check current practicum hours, supervision, placement rules and documentation with your department.`;
const canonical = `https://mindgracencr.in/blog/pages/adult/${slug}`;
const mark = institution.split(/\s+/).filter(Boolean).map((word) => word.replace(/[^A-Za-z]/g, '')[0]).filter(Boolean).slice(0, 3).join('').toUpperCase();
const logoSrc = profile?.logo ? `/assets/images/institute_logos/${profile.logo}` : '';
// The FAQ extraction callout is authored as literal markup (never inside a
// String.raw payload) so structural validators can count it statically.
const answerText = `Before accepting a psychology internship, confirm that the placement, supervisor, permitted activities, hours and required records meet your department's current rules. Get approval in writing.`;
// Head metadata is assembled from fragments so no backtick ever appears
// inside the String.raw template below (the raw delimiter cannot contain one).
const headExtra = String.raw`<link rel="canonical" href="${canonical}"><title>${title}</title><meta name="description" content="${description}"><meta property="og:title" content="${title}"><meta property="og:description" content="${description}"><meta property="og:url" content="${canonical}"><meta property="og:type" content="article"><meta name="blog-title" content="${institution}: psychology internship guide"><meta name="blog-description" content="${description}"><meta name="blog-date" content="2026-10-09"><meta property="article:modified_time" content="2026-11-07T00:00:00+05:30"><meta name="blog-tags" content="students, psychology, internship, ${location}">`;
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: (profile?.faqs ?? []).map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) };
---
<Layout headExtra={headExtra}>
<main id="main-content" class="seo-page classic-blog-reading">
  <Breadcrumbs canonical={canonical} items={[
    { name: 'Home', href: '/' },
    { name: 'Blog', href: '/blog' },
    { name: 'Internship guides', href: '/student-internship-guides' },
    { name: institution },
  ]} />
  <article>
    <div class="institution-identity">
      {logoSrc
        ? <img width="72" height="72" loading="lazy" alt={profile?.alt ?? `${institution} logo`} decoding="async" class="institution-logo" src={logoSrc} />
        : <span class="institution-mark" aria-hidden="true">{mark}</span>}
      <div><p class="seo-kicker">Student internship guide · {location}{profile?.rciPathway ? ' · RCI licensing pathway' : ''}</p><h1>{institution}: psychology internship guide</h1></div>
    </div>
    <div class="blog-answer"><strong>In short:</strong> {answerText}</div>
    <p class="lead">{fallbackFocus}</p>
    <p class="editorial-note">Programme names, recognition, curricula and placement rules can change. Verify current details with the institution and your department; this guide is independent and is not an official university statement.</p>
    {profile && (
      <>
        <h2>Programmes offered</h2>
        <ul>{profile.programs.map((program) => <li>{program}</li>)}</ul>
        <h2>Syllabus highlights</h2>
        <ul>{profile.syllabus.map((line) => <li>{line}</li>)}</ul>
        <h2>Internship and practicum requirements</h2>
        <ul>{profile.practicum.map((line) => <li>{line}</li>)}</ul>
        <h2>Special features</h2>
        <ul>{profile.features.map((line) => <li>{line}</li>)}</ul>
        <h2>Compare a placement with your learning goals</h2>
        <p>Programme information can change between admission cycles. Use the current university handbook to confirm course names, recognition, practicum requirements and placement approval. A programme page alone cannot confirm that a particular clinic has a current opening.</p>
      </>
    )}
    {!profile && (
      <>
        <h2>What to verify before applying</h2>
        <p>{fallbackGuidance}</p>
        <p>Ask whether the placement is clinical, counselling, educational, organisational, research, or forensic. Confirm the supervisor’s role, the hours that count, privacy and safeguarding expectations, and whether students observe, assist with research, or have any other clearly defined responsibility.</p>
      </>
    )}
    <h2>Questions about your university requirements</h2>
    <p>Check whether your department requires an internship letter, attendance record, case or project report, reflective notebook, supervisor evaluation, or a particular number of hours. A hospital or clinic name alone does not establish that a placement is available or that it satisfies your course.</p>
    <h2>Asking Mind Grace about an opportunity</h2>
    <p>Students may use the <a href="/clinical-psychology-internship">Mind Grace internship enquiry guide</a> to ask about current availability in Greater Noida. An enquiry is not a placement offer. Confirm the supervisor, dates, permitted activities, hours and documentation in writing, and obtain department approval before starting. Students must not independently diagnose, interpret tests for patients, or provide therapy.</p>
    {profile && profile.faqs.length > 0 && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
        <h2>Frequently asked questions</h2>
        {profile.faqs.map((item) => <div class="internship-faq"><h3>{item.question}</h3><p>{item.answer}</p></div>)}
      </>
    )}
    <p>For a general regional comparison, see <a href="/blog/pages/adult/psychology-institutions-delhi-ncr">the Delhi NCR institutions guide</a>.</p>
  </article>
</main></Layout>
