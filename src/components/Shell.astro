---
import aasha from '../data/aasha.json';
interface Props { brandLogo?: string; brandName?: string; brandAlt?: string; }
const { brandLogo, brandName, brandAlt } = Astro.props;
/**
 * Static site chrome (emergency banner, skip link, header, footer).
 *
 * The markup below is the exact HTML that assets/js/visitor-friendly.js
 * generates at runtime (extracted by scripts/normalize_site_shell.py), so
 * pages ship it pre-rendered. The runtime enhancer detects the
 * `data-shared-shell` attributes and enriches the existing nodes (active-link
 * highlighting, mobile panel, theme/accessibility wiring) instead of
 * rebuilding them — no flash of unstyled navigation, and the shell works with
 * JavaScript disabled.
 */
const navigation = [
  ['Home', '/'],
  ['About', '/about'],
  ['Patient care', '/services'],
  ['Academic training', '/academic-training'],
  ['Online consultations', '/teleconsultation'],
  ['Contact', '/contact'],
];
const patientLinks = [
  ['Aasha child care', '/aasha'],
  ['Psychiatry', '/psychiatry'],
  ['Therapy and counselling', '/therapy'],
  ['Conditions', '/conditions'],
  ['Assessments', '/assessments'],
  ['Teleconsultation', '/teleconsultation'],
];
const academicLinks = [
  ['Academic training hub', '/academic-training'],
  ['Academic programs & workshops', '/#academic-stream'],
  ['Internship enquiries', '/clinical-psychology-internship'],
  ['Internship guides by institute', '/student-internship-guides'],
  ['Student resources', '/resources'],
  ['Research and learning', '/blog'],
];
// FIX (dropdown menu bar): desktop group headers used to be plain <span>s,
// which are not focusable or clickable — touch devices and keyboard users
// could never open the submenus, and hover-only CSS left the panels stuck
// closed on many pages (including /book). They are now real <button>s wired
// for click-to-toggle + Escape/outside-click by assets/js/visitor-friendly.js
// (bindDesktopDropdowns), with aria-expanded/aria-controls for accessibility.
const funnelMarkup = (id: string, label: string, links: string[][]) => `<li class="nav-funnel"><button type="button" class="nav-funnel-trigger" id="${id}-trigger" aria-expanded="false" aria-haspopup="true" aria-controls="${id}">${label}<svg class="nav-funnel-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><ul class="nav-funnel-menu" id="${id}" hidden>${links.map(([linkLabel, href]) => `<li><a href="${href}">${linkLabel}</a></li>`).join('')}</ul></li>`;
---
<aside class="emergency-banner emergency-banner--static" aria-label="Emergency help"><div class="emergency-banner__content"><span>Need urgent help?</span><a href="tel:112">Call 112</a><a href="/emergency">Other emergency support</a></div></aside>
<header class="site-header" data-shared-shell>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="header-inner">
    <a class="logo-link" href="/">
      <img class="logo-img" src={brandLogo ?? '/assets/images/mind-grace-clinic-logo-pink.svg'} alt={brandAlt ?? 'Mind Grace Neuropsychiatric Clinic'} width="180" height="60" loading="eager" decoding="async">
      <span class="logo-copy"><span class="logo-text" id="site-logo-name">{brandName ?? 'Mind Grace'}</span><span class="logo-tagline">{brandName ? 'Independent student guide' : 'Care that starts with you'}</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation"><ul>{navigation.slice(0, 2).map(([label, href]) => <li><a href={href}>{label}</a></li>)}<Fragment set:html={funnelMarkup('nav-patient-care', 'Patient care', patientLinks)} /><Fragment set:html={funnelMarkup('nav-academic-training', 'Academic training', academicLinks)} /><li><a href="/teleconsultation">Online consultations</a></li><li><a href="/contact">Contact</a></li><li><a class="btn btn--primary" href="/book">Book an appointment</a></li></ul></nav>
    <div class="header-actions">
      <button type="button" class="accessibility-toggle" id="accessibility-toggle" aria-expanded="false" aria-controls="accessibility-panel" aria-label="Accessibility settings">Accessibility</button>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" aria-label="Use dark theme"><i data-lucide="moon" aria-hidden="true"></i><span class="visually-hidden">Dark theme</span></button>
      <button type="button" class="mobile-nav-trigger" id="burgerMenuBtn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav-panel"><i data-lucide="menu" aria-hidden="true"></i></button>
      <a class="mobile-book-btn" href="/book" aria-label="Book an appointment"><i data-lucide="calendar-days" aria-hidden="true"></i><span class="mobile-book-label">Book</span><span class="visually-hidden">Book an appointment</span></a>
    </div>
  </div>
</header>
<noscript>
  <style is:inline>.header-actions { display: none !important; } .no-script-nav { padding: 1rem; display: flex; flex-wrap: wrap; gap: 1rem; background: #fff1f4; } .no-script-nav a { color: #721038; font-weight: 700; }</style>
  <nav class="no-script-nav" aria-label="Navigation without JavaScript">
    {navigation.map(([label, href]) => <a href={href}>{label}</a>)}
    <strong>Patient care</strong><a href="/aasha">Aasha child care</a><a href="/services">Care overview</a><a href="/psychiatry">Psychiatry</a><a href="/therapy">Therapy and counselling</a><a href="/conditions">Conditions</a><a href="/teleconsultation">Teleconsultation</a><strong>Academic training</strong><a href="/academic-training">Academic training hub</a><a href="/#academic-stream">Student programs & workshops</a><a href="/clinical-psychology-internship">Internship enquiries</a><a href="/student-internship-guides">Internship guides by institute</a><a href="/resources">Student resources</a><a href="/blog">Research and learning</a>
    <a href="/book">Book an appointment</a>
    <a href="/emergency">Emergency help</a>
  </nav>
</noscript>
<slot />
<footer class="site-footer" data-shared-shell>
  <div class="footer-container">
    <div class="footer-brand"><img class="footer-logo" src="/assets/images/mind-grace-clinic-logo-pink.svg" alt="Mind Grace Neuropsychiatric Clinic" width="180" height="60" loading="lazy"><p class="footer-tagline">Care that starts with you</p><p class="footer-description">Psychiatry and counselling in Greater Noida, with child development care through Aasha.</p><a class="footer-phone" href="tel:+919667863295">Call +91 96678 63295</a></div>
    <nav class="footer-links" aria-label="Footer navigation"><div><h2>Care</h2><ul><li><a href="/services">Services</a></li><li><a href="/aasha">Aasha child development</a></li><li><a href="/process">What to expect</a></li><li><a href="/location">Visit the clinic</a></li><li><a href="/book">Book an appointment</a></li></ul></div><div><h2>Explore</h2><ul><li><a href="/resources">Resources and tools</a></li><li><a href="/blog">Mental health guides</a></li><li><a href="/academic-training">Academic training</a></li><li><a href="/faq">Frequently asked questions</a></li><li><a href="/contact">Contact</a></li></ul></div></nav>
    <address class="footer-contact"><strong class="footer-contact__title">Mind Grace Clinic</strong><p>J123, Gamma II<br>Greater Noida, 201310</p><p><a href="mailto:contact@mindgracencr.in">contact@mindgracencr.in</a></p></address>
  </div><section class="footer-aasha" aria-labelledby="footer-aasha-title">
    <a href="/aasha"><img src={aasha.logo} alt={aasha.shortName} width="120" height="80" loading="lazy" /></a>
    <div><h2 id="footer-aasha-title">Aasha Early Intervention Centre</h2><p>Child development care in Gamma 2, Greater Noida.</p><nav aria-label="Aasha information"><a href="/aasha">Explore Aasha care</a><a href="/aasha/book">Enquire about an appointment</a></nav></div>
  </section><div class="footer-bottom"><p>&copy; <span id="year">2026</span> Mind Grace Neuropsychiatric Clinic. Educational information only.</p><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/disclaimer">Disclaimer</a></div></div>
</footer>

<style>
.footer-aasha{display:flex;gap:1rem;align-items:center;width:min(100% - 2rem,1180px);margin:1.5rem auto 0;padding-top:1.25rem;border-top:1px solid currentColor}
.footer-aasha img{width:120px;height:80px;object-fit:contain;background:#fff;border-radius:10px}
.footer-aasha h2{font-size:1.15rem;margin:0 0 .75rem}.footer-aasha p{margin:.5rem 0}.footer-aasha nav{display:flex;flex-wrap:wrap;gap:.75rem 1.25rem;margin-top:1rem}.footer-aasha a{text-decoration:underline}
@media(max-width:600px){.footer-aasha{flex-direction:column}.footer-aasha nav{display:grid;grid-template-columns:1fr}}
</style>
