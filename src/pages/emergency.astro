const bodyStart = String.raw`<aside class="emergency-banner emergency-banner--static" role="note" aria-labelledby="emergency-notice-title"><div class="emergency-banner__content"><span id="emergency-notice-title">Not an emergency service.</span><span>Immediate danger? Call <a href="tel:112">112</a>.</span><a href="/emergency">Emergency resources</a></div></aside>`;
---

<Layout headExtra={headExtra} bodyStart={bodyStart} bodyAttrs=`data-design-system="rose-serenity"`>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5RBGN42B"
title="Google Tag Manager container" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

  <div id="network-status" class="network-status" role="status" aria-live="polite" hidden><span class="network-status-message"></span></div>

<script type="application/ld+json">{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://mindgracencr.in/"}, {"@type": "ListItem", "position": 2, "name": "Emergency", "item": "https://mindgracencr.in/emergency"}]}</script>
  <link rel="icon" href="/assets/images/favicon.ico" type="image/x-icon">


  <!-- EMERGENCY BANNER WITH MARQUEE -->



<!-- MOBILE NAV OVERLAY -->
  <div class="mobile-nav-overlay" id="mobile-nav-overlay" hidden></div>

  <!-- MOBILE NAV PANEL - Simplified -->
  <nav class="mobile-nav-panel" id="mobile-nav-panel" aria-label="Mobile navigation" inert hidden>
    <div class="mobile-nav-header">
      <h2>Menu</h2>
      <button type="button" class="close-mobile-menu" aria-label="Close menu">
        <i data-lucide="x" style="width:24px;height:24px" aria-hidden="true"></i>
      </button>
    </div>
    <div class="mobile-nav-content">
      <div class="mobile-nav-section">
        <div class="mobile-nav-section-title">Explore</div>
        <ul class="mobile-nav-list">
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Our Services</a></li>
          <li><a href="/process">What to Expect</a></li>
          <li><a href="/location">Find Us</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="mobile-nav-section">
        <div class="mobile-nav-section-title">Resources &#x26; Tools</div>
        <ul class="mobile-nav-list">
          <li><a href="/gallery">Gallery</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/book">Resource Book</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/faq#common-questions">Frequently asked questions</a></li>
        </ul>
      </div>

      <div class="mobile-nav-section">
        <div class="mobile-nav-section-title">Therapeutic Tools</div>
        <ul class="mobile-nav-list">
          <li><a href="/tools/guided-breathing">Guided Breathing</a></li>
          <li><a href="/tools/butterfly-tapper">Butterfly Tapper</a></li>
          <li><a href="/tools/eye-movement">Eye Movement</a></li>
          <li><a href="/tools/hypnos-fractal">Hypnotic Fractal</a></li>
          <li><a href="/tools/horizon-scan">Horizon Scan</a></li>
          <li><a href="/tools/leaf-on-stream">Leaf on Stream</a></li>
        </ul>
      </div>

      <div class="mobile-nav-section">
        <a href="/book" class="cta-button">Book Appointment</a>
      </div>
    </div>
  </nav>

<!-- MOBILE NAV OVERLAY -->

<!-- MOBILE NAV PANEL -->

  <!-- SKIP LINK -->
  <a href="#main-content" class="visually-hidden">Skip to main content</a>

  <!-- HEADER -->

  <!-- PROGRESS INDICATOR -->
  <div class="progress" aria-hidden="true">
    <div class="progress-bar" data-progress=""></div>
  </div>

  <!-- MAIN CONTENT -->
  <main id="main-content" tabindex="-1">
      <div class="seo-answer"><strong>Direct answer:</strong> If there is immediate danger, call 112 or go to the nearest emergency department. For mental-health support in India, call Tele-MANAS at 14416 or 1800-89-14416. Mind Grace is not an emergency service.</div>
<nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Emergency Resources</li></ol></nav>


    <!-- HERO SECTION - High Contrast Emergency -->
    <section class="hero hero-small emergency-hero">
      <div class="hero-inner">
        <div class="hero-content">
          <span class="section-badge emergency-badge">Immediate help</span>
          <h1>Need urgent mental-health help?</h1>
          <p class="lead">If you or someone else may be in immediate danger, call <strong>112</strong> now or go to the nearest emergency department. For mental-health support, call <strong>Tele-MANAS: 14416</strong> or <strong>1800-89-14416</strong>.</p>

          <!-- PRIMARY EMERGENCY ACTION -->
          <div class="emergency-alert alert alert-error">
            <i data-lucide="info" class="icon icon-lg" aria-hidden="true"></i>
          <div>
            <strong>Choose the number that fits the situation.</strong>
            <p style="margin-top: 0.5rem;"><a class="button button-primary" href="tel:112">Call emergency services: 112</a> <a class="button button-outline" href="tel:14416">Call Tele-MANAS: 14416</a></p>
            <p>Tele-MANAS alternate number: <a href="tel:1800-89-14416">1800-89-14416</a>. If you cannot get through and danger is immediate, call 112.</p>
          </div>
        </div>
      </div>
    </div></section>

    <!-- HOSPITAL RESOURCES -->
    <section class="section">
      <div class="shell">
        <div class="section-header">
          <h2>Nearby emergency departments</h2>
          <p>Call 112 for immediate danger. You may also contact a nearby hospital directly to confirm the quickest route for emergency care.</p>
        </div>

        <div class="services-grid">
          <article class="service-card">
            <div class="service-icon">
              <i data-lucide="building" class="icon icon-lg" aria-hidden="true"></i>
            </div>
            <h3>Sharda Hospital</h3>
            <p>Knowledge Park III, Greater Noida. Sharda lists a 24-hour emergency and trauma centre; call to confirm the appropriate service.</p>
            <div class="card-actions">
              <a href="tel:+918447333999" class="button button-outline">Call Sharda Hospital</a>
              <a href="https://maps.google.com/?q=Sharda+Hospital+Greater+Noida" target="_blank" rel="noopener" class="button button-ghost" aria-label="Get directions to Sharda Hospital (opens in a new window)">Get Directions</a>
            </div>
          </article>

          <article class="service-card">
            <div class="service-icon">
              <i data-lucide="building" class="icon icon-lg" aria-hidden="true"></i>
            </div>
            <h3>Yatharth Super Speciality Hospital</h3>
            <p>Omega I, Greater Noida. Contact the hospital to confirm emergency arrangements.</p>
            <div class="card-actions">
              <a href="tel:18003300000" class="button button-outline">Call Yatharth emergency line</a>
              <a href="https://maps.google.com/?q=Yatharth+Hospital+Greater+Noida" target="_blank" rel="noopener" class="button button-ghost" aria-label="Get directions to Yatharth Hospital (opens in a new window)">Get Directions</a>
            </div>
          </article>


        </div>
        <p>Official details: <a href="https://112.gov.in/" rel="noopener" target="_blank">India’s emergency response number 112</a> · <a href="https://dghs.mohfw.gov.in/national-mental-health-programme.php" rel="noopener" target="_blank">Government of India Tele-MANAS information</a>.</p>
      </div>
    </section>

    <!-- NON-EMERGENCY CLARIFICATION -->
    <section class="section section-alt">
      <div class="shell">
        <div class="notice-box notice-warning">
          <i data-lucide="alert-triangle" class="icon icon-lg" aria-hidden="true"></i>
          <div>
            <h3>This page is for urgent situations only</h3>
            <p>
              If this is <strong>not an emergency</strong> but you still need help, please reach out through our regular consultation process.
              For ongoing mental health support, therapy, or psychiatric evaluation, we're here to help through scheduled appointments.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA SECTION -->
    <section class="section-cta">
      <div class="shell">
        <div class="section-cta-center">
          <h2>Need ongoing support?</h2>
          <p>For non-emergency mental-health care, request a consultation through the regular booking process.</p>
          <div class="cta-group">
            <a href="/book" class="button button-large button-primary">Book a Consultation</a>
            <a href="/contact" class="button button-large button-outline">Contact Us</a>
            <a href="/" class="button button-large button-ghost">Back to Homepage</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER - Substantial Visual Weight -->

  <!-- JAVASCRIPT - Minimal, Interaction Only -->
  <script>
    // Year update
    const year = document.getElementById('year');
    if (year) year.textContent = String(new Date().getFullYear());
  </script>
</Layout>
