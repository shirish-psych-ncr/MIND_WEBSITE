    .mg-form input, .mg-form select, .mg-form textarea { width: 100%; box-sizing: border-box; padding: 0.7rem 0.85rem; border: 1px solid var(--mg-border-strong); border-radius: 0.6rem; background: var(--mg-surface-strong); color: var(--mg-ink-strong); font: inherit; font-size: 0.92rem; transition: background 0.2s, border-color 0.2s, box-shadow 0.2s; }
