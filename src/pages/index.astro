---
import Layout from '../layouts/Layout.astro';
const headExtra = String.raw`
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <meta name="author" content="Mind Grace Neuropsychiatric Clinic">
  <meta name="robots" content="index, follow">

  <title>Mind Grace Clinic &amp; Training Hub | Greater Noida</title>
  <meta name="description" content="Psychiatry, counselling, child-development care through Aasha and supervised psychology training at Mind Grace in Gamma II, Greater Noida, Delhi NCR.">
  <link rel="canonical" href="https://mindgracencr.in/">
`;
---

<Layout headExtra={headExtra}>
  <main id="main-content" tabindex="-1">

    <!-- Patient and academic pathways -->
    <section class="mg-landing mg-hero" aria-labelledby="mg-hero-title">
      <div class="container">
        <div class="mg-hero-head">
          <span class="mg-pill mg-pill--soft"><span class="mg-dot" aria-hidden="true"></span>Neuropsychiatric clinic &amp; training institute · Greater Noida, Delhi NCR</span>
          <h1 id="mg-hero-title">Care for your mind. <span class="mg-accent">Training for future clinicians.</span></h1>
          <p>Mind Grace offers confidential psychiatric and counselling consultations, with all child-related care through Aasha Early Intervention Centre in Gamma II, Greater Noida — and supervised clinical training for psychology and medical students.</p>
        </div>

        <div class="mg-gateways">
          <!-- Gateway 01: Patients & loved ones -->
          <article class="mg-card mg-gateway">
            <div class="mg-card__top">
              <span class="mg-pill mg-pill--care"><i data-lucide="heart-handshake" aria-hidden="true"></i>For patients &amp; families</span>
              <span class="mg-eyebrow">Pathway 01</span>
            </div>
            <h2>Consultations &amp; counselling</h2>
            <p>Evidence-based, private assessment and supportive treatment for depression, anxiety, OCD, neurodevelopmental conditions, and psychotherapy.</p>
            <ul class="mg-badge-grid" role="list">
              <li><i data-lucide="badge-check" aria-hidden="true"></i>Consultant psychiatrist-led care</li>
              <li><i data-lucide="badge-check" aria-hidden="true"></i>M.Phil-qualified clinical psychologists</li>
              <li><i data-lucide="map-pin" aria-hidden="true"></i>In-clinic &amp; teleconsultation</li>
              <li><i data-lucide="lock" aria-hidden="true"></i>Confidential records handling</li>
            </ul>
            <div class="mg-card__actions">
              <a class="btn btn--primary" href="/book">Book a consultation</a>
              <a class="btn btn-outline" href="#booking-section">Quick enquiry form</a>
              <a class="btn btn-outline" href="/services">Explore clinical services</a>
            </div>
          </article>

          <!-- Gateway 02: Students & aspiring professionals -->
          <article class="mg-card mg-gateway">
            <div class="mg-card__top">
              <span class="mg-pill mg-pill--learn"><i data-lucide="graduation-cap" aria-hidden="true"></i>For students &amp; academics</span>
              <span class="mg-eyebrow">Pathway 02</span>
            </div>
            <h2>Internships, trainings &amp; workshops</h2>
            <p>Supervised clinical psychology internships, psychometric testing practice, diagnostic interviewing skills, and workshops for psychology and medical students.</p>
            <ul class="mg-badge-grid" role="list">
              <li><i data-lucide="calendar-days" aria-hidden="true"></i>Summer &amp; winter cohorts</li>
              <li><i data-lucide="clipboard-list" aria-hidden="true"></i>MSE &amp; case-history demonstrations</li>
              <li><i data-lucide="brain" aria-hidden="true"></i>Psychometrics orientation sessions</li>
              <li><i data-lucide="file-text" aria-hidden="true"></i>Letter of completion guidance</li>
            </ul>
            <div class="mg-card__actions">
              <a class="btn btn--primary" href="/clinical-psychology-internship">Explore student programs</a>
              <a class="btn btn-outline" href="#booking-section" data-enquiry-kind="academic">Training enquiry</a>
              <a class="btn btn-outline" href="/resources">Student resources</a>
            </div>
          </article>
        </div>

        <!-- Trust strip (edited to verifiable, non-numeric claims) -->
        <div class="mg-trust" role="list" aria-label="Clinic commitments">
          <span role="listitem"><strong>Clinician-led care</strong><small>Consultations led by Dr. Anita Sharma</small></span>
          <span role="listitem"><strong>Clear process</strong><small>Structured first visit, next steps explained</small></span>
          <span role="listitem"><strong>Transparent fees</strong><small>Fees shared before care begins</small></span>
          <span role="listitem"><strong>Privacy respected</strong><small>Confidential records, consent-first approach</small></span>
        </div>
      </div>
    </section>

    <!-- STREAM SWITCHER NAVIGATION (anchor links only — works without JS) -->
    <nav class="mg-switchbar" aria-label="Page sections">
      <div class="container mg-switchbar__inner">
        <span class="mg-eyebrow">Jump to:</span>
        <div class="mg-switchbar__tabs">
          <a class="mg-tab mg-tab--active" href="#patient-stream"><i data-lucide="stethoscope" aria-hidden="true"></i>Patient care highlights</a>
          <a class="mg-tab" href="#academic-stream"><i data-lucide="book-open" aria-hidden="true"></i>Student &amp; academic hub</a>
        </div>
        <a class="mg-live" href="/contact">Appointment enquiries open during clinic hours</a>
      </div>
    </nav>

    <!-- STREAM 1: PATIENT CARE HIGHLIGHTS -->
    <section class="mg-stream" id="patient-stream" aria-labelledby="patient-stream-title">
      <div class="container">
        <div class="mg-section-head">
          <div>
            <span class="mg-pill mg-pill--care"><i data-lucide="hospital" aria-hidden="true"></i>Evidence-based psychiatry &amp; therapy</span>
            <h2 id="patient-stream-title">Specialized neuropsychiatric &amp; psychological care</h2>
            <p>Personalized treatment plans that combine medical evaluation, structured talk therapy, and practical family guidance — in a respectful, non-judgmental setting.</p>
          </div>
          <a class="btn btn-outline" href="#booking-section">Request an appointment</a>
        </div>

        <div class="mg-service-grid">
          <article class="mg-card mg-service">
            <span class="mg-icon-chip" aria-hidden="true"><i data-lucide="activity"></i></span>
            <h3>Adult &amp; geriatric psychiatry</h3>
            <p>Careful diagnostic assessment and medication review, when appropriate, for depression, bipolar disorder, anxiety, schizophrenia-spectrum conditions, and later-life memory concerns.</p>
            <ul class="mg-bullets">
              <li><a href="/depression-anxiety">Depression &amp; anxiety care</a></li>
              <li><a href="/bipolar-mood-disorders">Bipolar mood disorders</a></li>
              <li><a href="/psychosis-schizophrenia">Schizophrenia-spectrum support</a></li>
              <li><a href="/depression-in-older-adults">Later-life depression &amp; memory</a></li>
            </ul>
            <div class="mg-service__links">
              <a class="mg-more-link" href="/psychiatry">Explore adult psychiatry<i data-lucide="chevron-right" aria-hidden="true"></i></a>
              <a class="mg-more-link" href="/specialized-consultations">Specialized consultations<i data-lucide="chevron-right" aria-hidden="true"></i></a>
            </div>
          </article>

          <article class="mg-card mg-service">
            <span class="mg-icon-chip" aria-hidden="true"><i data-lucide="sprout"></i></span>
            <h3>Clinical psychology &amp; psychotherapy</h3>
            <p>Individual talk therapy for emotional regulation, grief, trauma, and persistent obsessive or intrusive thoughts, planned around your goals and pace.</p>
            <ul class="mg-bullets">
              <li><a href="/evidence-based-therapies">Evidence-based therapy approaches</a></li>
              <li><a href="/ocd-panic-ptsd">OCD, panic &amp; PTSD care</a></li>
              <li><a href="/trauma-grief-support">Trauma &amp; grief support</a></li>
              <li><a href="/psychology-counselling">Counselling services</a></li>
            </ul>
            <div class="mg-service__links">
              <a class="mg-more-link" href="/therapy">Explore therapy options<i data-lucide="chevron-right" aria-hidden="true"></i></a>
              <a class="mg-more-link" href="/online-therapy-india">Therapy online in India<i data-lucide="chevron-right" aria-hidden="true"></i></a>
            </div>
          </article>

          <article class="mg-card mg-service">
            <span class="mg-icon-chip" aria-hidden="true"><i data-lucide="baby"></i></span>
            <img src="/assets/images/Aasha_early_intervention_logo.webp" alt="Aasha Early Intervention Centre" width="180" height="120" loading="lazy" style="object-fit:contain;background:white;border-radius:12px">
            <h3>Aasha Child Development &amp; Early Intervention Centre</h3>
            <p>All child-related care comes under Aasha: individualised assessments, speech and occupational therapy, special education, behavioural support and parent guidance.</p>
            <ul class="mg-bullets">
              <li><a href="/adhd-autism-assessment">ADHD &amp; autism assessment</a></li>
              <li><a href="/learning-disability-assessment">Learning disability assessment</a></li>
              <li><a href="/child-student-mental-health">Student mental health</a></li>
              <li><a href="/aasha/speech-language-therapy">Speech and language therapy</a></li>
              <li><a href="/aasha/occupational-therapy">Occupational therapy</a></li>
              <li><a href="/aasha/special-education">Special education</a></li>
              <li><a href="/aasha/behavioural-support">ABA and behavioural support</a></li>
            </ul>
            <div class="mg-service__links">
              <a class="mg-more-link" href="/aasha">Explore Aasha’s team and services<i data-lucide="chevron-right" aria-hidden="true"></i></a>
            </div>
          </article>

          <article class="mg-card mg-service">
            <span class="mg-icon-chip" aria-hidden="true"><i data-lucide="moon-star"></i></span>
            <h3>De-addiction &amp; lifestyle wellness</h3>
            <p>Support for substance-use concerns, sleep difficulties, and burnout — coordinated with medical review and relapse-prevention planning.</p>
            <ul class="mg-bullets">
              <li><a href="/addiction-substance-use">Addiction &amp; substance-use support</a></li>
              <li><a href="/sleep-eating-disorders">Sleep &amp; eating disorders</a></li>
              <li><a href="/assessments">Psychometric assessments</a></li>
              <li><a href="/conditions#anxiety">Stress &amp; anxiety care</a></li>
            </ul>
            <div class="mg-service__links">
              <a class="mg-more-link" href="/conditions">View conditions we treat<i data-lucide="chevron-right" aria-hidden="true"></i></a>
            </div>
          </article>
        </div>

        <!-- Clinical team spotlight (real, site-consistent clinician) -->
        <div class="mg-team">
          <div class="mg-team__intro">
            <span class="mg-eyebrow">Faculty leadership</span>
            <h3>Clinicians who lead every consultation</h3>
            <p>Care at Mind Grace is led by our consultant psychiatrist, with counselling and assessments delivered by trained members of the clinical team.</p>
          </div>
          <div class="mg-team__grid">
            <article class="mg-card mg-doctor">
              <img src="/assets/images/dr-anita-sharma-personal-photo-480.webp" alt="Dr. Anita Sharma, Consultant Psychiatrist at Mind Grace Neuropsychiatric Clinic" width="96" height="120" loading="lazy" decoding="async">
              <div>
                <p class="mg-doctor__name">Dr. Anita Sharma <span class="mg-chip">Consultant Psychiatrist</span></p>
                <p class="mg-doctor__role">Founder &amp; Lead Psychiatrist</p>
                <p class="mg-doctor__bio">Leads psychiatric evaluation, medication review, and combined care plans for adults, adolescents, and children at Mind Grace in Greater Noida.</p>
                <p class="mg-doctor__meta"><a href="/dr-anita-sharma">Read full profile</a><span aria-hidden="true">·</span><a href="/doctors">Meet the team</a></p>
              </div>
            </article>
            <article class="mg-card mg-doctor">
              <span class="mg-avatar-fallback" role="img" aria-label="Profile illustration for Dr. Sana Firdous">SF</span>
              <div>
                <p class="mg-doctor__name">Dr. Sana Firdous <span class="mg-chip">M.Phil Clinical Psychology</span></p>
                <p class="mg-doctor__role">Clinical Psychologist · 7+ years experience</p>
                <p class="mg-doctor__bio">Provides psychotherapy, psychodiagnostic assessment, and psychological testing for children, adolescents, and adults.</p>
                <p class="mg-doctor__meta"><a href="/doctors">Meet the team</a><span aria-hidden="true">·</span><a href="/therapy">Therapy services</a></p>
              </div>
            </article>
            <aside class="mg-note">
              <h3>Not sure where to start?</h3>
              <p>Psychiatry addresses medical evaluation and medication when needed. Psychology and counselling focus on therapy and coping skills. A short conversation with the clinic can help you choose.</p>
              <a class="btn btn-secondary" href="/psychiatrist-vs-psychologist">Compare care roles</a>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- STREAM 2: ACADEMIC & TRAINING HIGHLIGHTS -->
    <section class="mg-stream mg-stream--alt" id="academic-stream" aria-labelledby="academic-stream-title">
      <div class="container">
        <div class="mg-section-head">
          <div>
            <span class="mg-pill mg-pill--learn"><i data-lucide="graduation-cap" aria-hidden="true"></i>Institutional training wing</span>
            <h2 id="academic-stream-title">Programs that connect theory with clinical reality</h2>
            <p>Students observe ethical practice, practise core assessment skills, and discuss cases with supervision — with clear boundaries around confidentiality and scope.</p>
          </div>
          <a class="btn btn--primary" href="/clinical-psychology-internship">Review internship guide and terms</a>
        </div>

        <div class="mg-program-grid">
          <article class="mg-card mg-program">
            <div class="mg-card__top">
              <span class="mg-chip">Cohort program</span>
              <span class="mg-chip mg-chip--accent"><i data-lucide="clock" aria-hidden="true"></i>Flexible duration</span>
            </div>
            <h3>Clinical psychology internship</h3>
            <p>Structured outpatient exposure designed for undergraduate and postgraduate psychology students.</p>
            <ul class="mg-checks">
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Mental status examination (MSE) orientation.</li>
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Familiarity with DSM-5-TR and ICD-11 diagnostic frameworks.</li>
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Observed OPD sessions under confidentiality protocols.</li>
            </ul>
            <div class="mg-meta-strip"><span>Rolling intakes</span><span>Limited seats per batch</span></div>
            <div class="mg-card__actions">
              <a class="btn btn-outline w-full" href="/clinical-psychology-internship">See internship details</a>
              <a class="btn btn--primary w-full" href="#booking-section" data-enquiry-kind="academic">Apply via enquiry form</a>
            </div>
          </article>

          <article class="mg-card mg-program">
            <div class="mg-card__top">
              <span class="mg-chip">Skill workshop</span>
              <span class="mg-chip mg-chip--accent"><i data-lucide="calendar-days" aria-hidden="true"></i>Weekend sessions</span>
            </div>
            <h3>Psychometric assessment orientation</h3>
            <p>Demonstration-led sessions on the purpose, ethics, and interpretation basics of common assessment tools.</p>
            <ul class="mg-checks">
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Overview of projective and intelligence batteries.</li>
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Report-writing and case-formulation practice tasks.</li>
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Guidance on test-user qualifications and limits.</li>
            </ul>
            <div class="mg-meta-strip"><span>Materials listed in advance</span><span>Hands-on demos</span></div>
            <a class="btn btn-outline w-full" href="/resources#tools">Browse student resources</a>
          </article>

          <article class="mg-card mg-program">
            <div class="mg-card__top">
              <span class="mg-chip">Brief course</span>
              <span class="mg-chip mg-chip--accent"><i data-lucide="users" aria-hidden="true"></i>Small groups</span>
            </div>
            <h3>Diagnostic interviewing practicum</h3>
            <p>Role-play and observed-practice sessions for history-taking, MSE documentation, and referral etiquette.</p>
            <ul class="mg-checks">
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Sample MSE templates and case-discussion format.</li>
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Ethics, consent, and boundaries discussion.</li>
              <li><i data-lucide="circle-check" aria-hidden="true"></i>Feedback from supervising clinicians.</li>
            </ul>
            <div class="mg-meta-strip"><span>Questions to ask before applying</span><span>FAQ included</span></div>
            <a class="btn btn-outline w-full" href="/faq">Read training FAQs</a>
          </article>
        </div>

        <div class="mg-fineprint">
          <p>Training involves observation and supervised learning activities. It does not confer licensure, prescription rights, or independent clinical practice. Eligibility, tool access, and any certification terms are confirmed individually before enrollment.</p>
          <p><a href="/faq#common-questions">Questions about eligibility?</a> See the FAQ or <a href="/contact">contact the academic desk</a>.</p>
        </div>
      </div>
    </section>

    <!-- FAST CONNECT: PATIENT APPOINTMENT & TRAINING ENQUIRY FORMS (edited copy) -->
    <section class="mg-booking" id="booking-section" aria-labelledby="booking-title">
      <div class="container">
        <div class="mg-card mg-portal">
          <div class="mg-portal__head">
            <div>
              <span class="mg-eyebrow">Fast connect</span>
              <h2 id="booking-title">Request an appointment or a training callback</h2>
              <p>Share only basic details here — please don't include medical history or emergency information in these forms.</p>
            </div>
            <div class="mg-switchbar__tabs" role="group" aria-label="Choose form type">
              <button type="button" class="mg-tab mg-tab--active" id="form-tab-patient" data-form-target="patient-form-container" aria-pressed="true"><i data-lucide="stethoscope" aria-hidden="true"></i>Patient consultation</button>
              <button type="button" class="mg-tab" id="form-tab-academic" data-form-target="academic-form-container" aria-pressed="false"><i data-lucide="graduation-cap" aria-hidden="true"></i>Student &amp; training</button>
            </div>
          </div>

          <!-- FORM CONTAINER: PATIENT OPD -->
          <div id="patient-form-container">
            <p class="mg-notice mg-notice--care"><i data-lucide="shield-check" aria-hidden="true"></i>Enquiry details are used only to coordinate your appointment and are handled confidentially by the clinical team.</p>
            <form class="mg-form" data-contact-form="patient">
              <div class="mg-form__row">
                <div>
                  <label for="pt-name">Patient name (or family representative) *</label>
                  <input id="pt-name" name="name" type="text" autocomplete="name" placeholder="e.g. Rohini Gupta" required>
                </div>
                <div>
                  <label for="pt-phone">Mobile / WhatsApp number *</label>
                  <input id="pt-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91 9XXXXXXXXX" required>
                </div>
              </div>
              <div class="mg-form__row">
                <div>
                  <label for="pt-specialty">Area of concern *</label>
                  <select id="pt-specialty" name="specialty" required>
                    <option value="">Select primary concern / service</option>
                    <option value="psychiatry">Psychiatric consultation (mood, anxiety, bipolar)</option>
                    <option value="psychotherapy">Counselling &amp; psychotherapy</option>
                    <option value="child">Aasha child &amp; adolescent evaluation</option>
                    <option value="deaddiction">Substance-use support</option>
                    <option value="geriatric">Later-life memory concerns</option>
                    <option value="unsure">Not sure — please guide me</option>
                  </select>
                </div>
                <div>
                  <label for="pt-mode">Preferred mode *</label>
                  <select id="pt-mode" name="mode" required>
                    <option value="">Choose consultation mode</option>
                    <option value="clinic">In-clinic: Gamma II, Greater Noida</option>
                    <option value="tele">Online teleconsultation</option>
                  </select>
                </div>
              </div>
              <div class="mg-form__full">
                <label for="pt-note">Preferred day/time &amp; brief note (optional)</label>
                <textarea id="pt-note" name="note" rows="3" aria-describedby="pt-note-help"></textarea>
                <p id="pt-note-help" class="mg-field-help">For example: weekday evenings after 5:30 PM. Share appointment preferences only.</p>
              </div>
              <div class="mg-form__footer">
                <p>Clinic hours: Mon–Sat, 10:00 AM–4:00 PM and 5:30–7:30 PM. A team member will call or message you during working hours.</p>
                <button type="submit" class="btn btn--primary"><span>Send enquiry via WhatsApp</span><i data-lucide="send" aria-hidden="true"></i></button>
              </div>
            </form>
          </div>

          <!-- FORM CONTAINER: ACADEMIC ENQUIRY -->
          <div id="academic-form-container" hidden>
            <p class="mg-notice mg-notice--learn"><i data-lucide="badge-check" aria-hidden="true"></i>Internship and workshop enquiries are reviewed by the academic desk; eligibility and terms are confirmed individually before enrollment.</p>
            <form class="mg-form" data-contact-form="academic">
              <div class="mg-form__row">
                <div>
                  <label for="ac-name">Applicant name *</label>
                  <input id="ac-name" name="name" type="text" autocomplete="name" placeholder="e.g. Siddharth Verma" required>
                </div>
                <div>
                  <label for="ac-phone">WhatsApp / phone number *</label>
                  <input id="ac-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91 9XXXXXXXXX" required>
                </div>
              </div>
              <div class="mg-form__row">
                <div>
                  <label for="ac-college">University / college *</label>
                  <input id="ac-college" name="college" type="text" placeholder="e.g. Delhi University" required>
                </div>
                <div>
                  <label for="ac-degree">Current program &amp; year *</label>
                  <input id="ac-degree" name="degree" type="text" placeholder="e.g. BA Psychology, 2nd year" required>
                </div>
              </div>
              <div class="mg-form__full">
                <label for="ac-program">Program of interest *</label>
                <select id="ac-program" name="program" required>
                  <option value="">Select a program</option>
                  <option value="internship">Clinical psychology internship</option>
                  <option value="observership">Psychiatric clinical observership</option>
                  <option value="workshop">Psychometric assessment orientation</option>
                  <option value="practicum">Diagnostic interviewing practicum</option>
                  <option value="syllabus">Request program details &amp; schedule</option>
                </select>
              </div>
              <div class="mg-form__footer">
                <p>The academic desk will reply with the syllabus overview, schedule, and next steps.</p>
                <button type="submit" class="btn btn--primary"><span>Send enquiry via WhatsApp</span><i data-lucide="send" aria-hidden="true"></i></button>
              </div>
            </form>
          </div>

          <div class="mg-success" id="form-success-banner" role="status" tabindex="-1" hidden>
            <p><i data-lucide="circle-check" aria-hidden="true"></i>Continue in WhatsApp</p>
            <span>Send your prepared message in WhatsApp to complete the enquiry. If it did not open, contact the clinic directly at <a href="tel:+919667863295">+91 96678 63295</a> or use the <a href="/book">full booking flow</a>.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- QUICK ACCESS SUMMARY (edited copy) -->
    <section class="mg-access" aria-labelledby="access-title">
      <h2 id="access-title" class="visually-hidden">Quick clinic access summary</h2>
      <div class="container">
        <div class="mg-access__grid">
          <article class="mg-card mg-access__item">
            <span class="mg-icon-chip" aria-hidden="true"><i data-lucide="map-pin"></i></span>
            <h3>Clinic location</h3>
            <p>Conveniently located in Gamma II, Greater Noida, with easy access from across Delhi NCR.</p>
            <a class="mg-more-link" href="/location">Directions &amp; clinic details<i data-lucide="chevron-right" aria-hidden="true"></i></a>
          </article>
          <article class="mg-card mg-access__item">
            <span class="mg-icon-chip" aria-hidden="true"><i data-lucide="video"></i></span>
            <h3>Teleconsultation</h3>
            <p>Patients across India can request secure video consultations with follow-up plans shared digitally.</p>
            <a class="mg-more-link" href="/teleconsultation">How online consultations work<i data-lucide="chevron-right" aria-hidden="true"></i></a>
          </article>
          <article class="mg-card mg-access__item">
            <span class="mg-icon-chip" aria-hidden="true"><i data-lucide="award"></i></span>
            <h3>Training completion</h3>
            <p>Completion documentation is issued per the institute's terms and clarified with each trainee in advance.</p>
            <a class="mg-more-link" href="/clinical-psychology-internship">Internship guide &amp; terms<i data-lucide="chevron-right" aria-hidden="true"></i></a>
          </article>
        </div>

        <!-- First-visit essentials strip (links deeper pages into the landing flow) -->
        <div class="mg-essentials" aria-label="First-visit essentials">
          <a href="/fees"><i data-lucide="indian-rupee" aria-hidden="true"></i>Fees &amp; costs</a>
