---
import Layout from '../layouts/Layout.astro';

// Quiet landing page: one clear promise, two primary paths (patient care and
// training), and a compact "find your way in" directory of breadcrumbs so the
// home page orients visitors instead of overwhelming them. Detail lives on the
// section pages; the home page only names the doors.
const trails = [
  { label: 'Care', href: '/services', crumbs: ['Home', 'Care', 'Services & treatments'] },
  { label: 'Care', href: '/assessments', crumbs: ['Home', 'Care', 'Assessments'] },
  { label: 'Care', href: '/aasha', crumbs: ['Home', 'Care', 'Aasha Early Intervention'] },
  { label: 'Care', href: '/conditions', crumbs: ['Home', 'Care', 'Conditions we treat'] },
  { label: 'Care', href: '/process', crumbs: ['Home', 'Care', 'How visits work'] },
  { label: 'Care', href: '/fees', crumbs: ['Home', 'Care', 'Fees'] },
  { label: 'Care', href: '/teleconsultation', crumbs: ['Home', 'Care', 'Online consultations'] },
  { label: 'Care', href: '/book', crumbs: ['Home', 'Care', 'Book an appointment'] },
  { label: 'Learning', href: '/academic-training', crumbs: ['Home', 'Learning', 'Academic training hub'] },
  { label: 'Learning', href: '/clinical-psychology-internship', crumbs: ['Home', 'Learning', 'Internship enquiries'] },
  { label: 'Reading', href: '/blog', crumbs: ['Home', 'Reading', 'The journal'] },
  { label: 'Reading', href: '/resources#tools', crumbs: ['Home', 'Reading', 'Self-help tools'] },
  { label: 'The clinic', href: '/about', crumbs: ['Home', 'The clinic', 'About Mind Grace'] },
  { label: 'The clinic', href: '/doctors', crumbs: ['Home', 'The clinic', 'The clinical team'] },
  { label: 'The clinic', href: '/location', crumbs: ['Home', 'The clinic', 'Visit the clinic'] },
  { label: 'The clinic', href: '/faq', crumbs: ['Home', 'The clinic', 'Questions, answered'] },
];
const trailGroups = ['Care', 'Learning', 'Reading', 'The clinic'].map((label) => ({ label, trails: trails.filter((t) => t.label === label) }));

const headExtra = String.raw`
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f7f4ed" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1d1217" media="(prefers-color-scheme: dark)">
  <meta name="author" content="Mind Grace Neuropsychiatric Clinic">
  <meta name="robots" content="index, follow">
  <title>Psychiatrist in Greater Noida | Mind Grace</title>
  <meta name="description" content="Meet the Mind Grace care team in Gamma II. Explore psychiatry and counselling, or request a consultation.">
  <link rel="canonical" href="https://mindgracencr.in/">`;
---

<Layout headExtra={headExtra}>
  <main id="main-content" tabindex="-1">
    <div class="seo-answer"><strong>Mind Grace is a psychiatry and mental-health clinic in Greater Noida.</strong> Meet with our care team for psychiatric consultation, counselling, therapy and assessment. Child development services are provided through Aasha, our early intervention centre; online consultations are also available.</div>

    <section class="pn-hero wrap" aria-labelledby="pn-hero-title">
      <div class="pn-hero-copy">
        <p class="eyebrow"><span class="mini-line" aria-hidden="true"></span> PSYCHOLOGY. PEOPLE. PRACTICE.</p>
        <h1 id="pn-hero-title">Psychiatry and counselling<br><em>in Greater Noida</em></h1>
        <p class="pn-intro">A clear next step starts with being heard. Mind Grace offers psychiatric consultation and counselling in Gamma II, Greater Noida, with online consultations available. For children, Aasha brings developmental assessment and therapy together around each child and family.</p>
        <div class="pn-actions">
          <a class="btn btn--primary" href="/book">Book a consultation <span aria-hidden="true">↗</span></a>
          <a class="pn-text-link" href="#care-options">Choose your care <span aria-hidden="true">↓</span></a>
        </div>
        <p class="pn-footnote">Gamma II, Greater Noida · In-clinic and online consultations</p>
      </div>
    </section>

    <section id="care-options" class="pn-section wrap" aria-labelledby="care-options-title">
      <div class="pn-heading">
        <h2 id="care-options-title">Where would you like to start?</h2>
        <p class="pn-heading-intro">If you’re unsure whom to see, start with the care team’s guide to each role.</p>
      </div>
      <ul>
        <li><a href="/dr-anita-sharma">Meet Dr Anita Sharma, consultant psychiatrist</a></li>
        <li><a href="/assessments">Compare mental health assessment options</a></li>
        <li><a href="/psychology-counselling">Explore psychology and counselling</a></li>
        <li><a href="/aasha#first-visit">Plan a first visit for your child at Aasha</a></li>
        <li><a href="/doctors">Compare psychiatrist and psychologist roles</a></li>
        <li><a href="/fees">See fees before booking</a> or <a href="/location">get directions to the clinic</a></li>
      </ul>
    </section>

    <section id="streams" class="pn-section wrap" aria-labelledby="pn-work-title">
      <div class="pn-heading">
        <div><p class="eyebrow">01 / TWO STREAMS</p><h2 id="pn-work-title">Thoughtful care.<br><em>Thoughtful systems.</em></h2></div>
        <p class="pn-heading-intro">Some problems need a clear explanation. Others need a better way to work. These are the two streams on our desk.</p>
      </div>
      <div class="pn-list">
        <a class="pn-row" id="patient-stream" href="/services">
          <span class="pn-number">01</span>
          <span class="pn-icon pn-icon-care" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="pn-copy">
            <span class="pn-status"><i aria-hidden="true"></i> PATIENT CARE</span>
            <span class="pn-h3">One person. A connected team.</span>
            <span class="pn-p">Psychiatric consultations, counselling and psychotherapy, with all child-related care through Aasha Early Intervention Centre.</span>
            <span class="pn-rowtags">PSYCHIATRY <span aria-hidden="true">·</span> THERAPY <span aria-hidden="true">·</span> ASSESSMENTS</span>
          </span>
          <span class="pn-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="pn-row" id="academic-stream" href="/clinical-psychology-internship">
          <span class="pn-number">02</span>
          <span class="pn-icon pn-icon-learn" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span class="pn-copy">
            <span class="pn-status"><i aria-hidden="true"></i> TRAINING</span>
            <span class="pn-h3">From theory to defensible practice.</span>
            <span class="pn-p">Supervised clinical psychology internships, psychometric orientation, and interviewing practicums for students and academics.</span>
            <span class="pn-rowtags">INTERNSHIPS <span aria-hidden="true">·</span> WORKSHOPS <span aria-hidden="true">·</span> SUPERVISION</span>
          </span>
          <span class="pn-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section id="doors" class="pn-section wrap" aria-labelledby="pn-connections-title">
      <div class="pn-heading">
        <div><p class="eyebrow">02 / FIND YOUR WAY IN</p><h2 id="pn-connections-title">Explore Mind Grace</h2></div>
        <p class="pn-heading-intro">Find care, training, resources and clinic information.</p>
      </div>
      <div class="pn-groups">
        {trailGroups.map((group) => (
          <nav class="pn-group" aria-label={group.label}>
            <p class="pn-group-label">{group.label}</p>
            <ul class="pn-doors">
              {group.trails.map((trail) => (
                <li className="pn-crumb"><a href={trail.href}><span class="pn-trail">{trail.crumbs.at(-1)}</span><span class="pn-door-arrow" aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </section>
  </main>

  <style is:global>
    .pn-hero{display:block;width:min(100% - 2rem,var(--mg-wide-max,1220px));margin-inline:auto;padding-block:clamp(2.5rem,6vw,4.5rem)}
    .pn-hero .eyebrow,.pn-heading .eyebrow{display:flex;align-items:center;gap:.6rem;margin:0 0 1rem;color:var(--mg-link);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
    .mini-line{display:inline-block;width:2rem;height:2px;background:currentColor;flex:0 0 auto}
    .pn-hero h1{margin:0 0 1.25rem;font-size:clamp(2.3rem,5.5vw,3.9rem);line-height:1.05;letter-spacing:-.03em;text-wrap:balance}
    .pn-hero h1 em,.pn-heading h2 em{font-style:normal;color:var(--mg-accent)}
    .pn-intro{max-width:46ch;margin:0 0 1.6rem;font-size:clamp(1.02rem,1.6vw,1.2rem);line-height:1.65;color:var(--mg-ink-muted)}
    .pn-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.9rem 1.25rem}
    .pn-text-link{color:var(--mg-link);font-weight:800;text-decoration:none;border-bottom:2px solid currentColor;padding-bottom:.1rem}
    .pn-text-link:hover,.pn-text-link:focus-visible{color:var(--mg-link-hover)}
    .pn-footnote{margin:1.4rem 0 0;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;color:var(--mg-ink-muted)}
    .pn-section{padding-block:clamp(2.75rem,6vw,4.5rem)}
    .pn-heading{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1.25rem 2rem;margin-bottom:2rem}
    .pn-heading h2{margin:0;font-size:clamp(1.8rem,4vw,2.7rem);line-height:1.1;letter-spacing:-.025em;text-wrap:balance}
    .pn-heading-intro{max-width:38rem;margin:0;color:var(--mg-ink-muted);line-height:1.65}
    .pn-list{display:grid;gap:1.1rem}
    .pn-row{display:grid;grid-template-columns:auto auto minmax(0,1fr) auto;gap:1.25rem;align-items:center;background:var(--mg-surface-strong);border:1px solid var(--mg-border-strong);border-radius:1rem;padding:1.25rem 1.5rem;text-decoration:none;transition:border-color .2s,box-shadow .2s,transform .2s}
    .pn-row:hover{border-color:var(--mg-link);box-shadow:0 14px 30px -20px rgb(40 23 29/.45)}
    .pn-number{font-size:1rem;font-weight:800;color:var(--mg-border-strong)}
    .pn-icon{width:3rem;height:3rem;border-radius:.7rem;background:var(--mg-surface-soft);border:1px solid var(--mg-border);display:grid;place-items:center;padding:.6rem}
    .pn-icon span{display:block;width:100%;height:2px;border-radius:2px;background:var(--mg-link)}
    .pn-icon-care{grid-template-rows:repeat(3,auto)}
    .pn-icon-care span:nth-child(2){width:70%}
    .pn-icon-care span:nth-child(3){width:45%}
    .pn-icon-learn{grid-template-columns:repeat(2,1fr);gap:5px}
    .pn-icon-learn span{width:100%;height:100%;background:transparent;border:2px solid var(--mg-link);border-radius:4px}
    .pn-status{display:inline-flex;align-items:center;gap:.45rem;font-size:.66rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--mg-ink-muted)}
    .pn-status i{width:.5rem;height:.5rem;border-radius:50%;background:#0d9488;display:inline-block}
    .pn-h3{display:block;margin:.35rem 0 .3rem;font-size:clamp(1.15rem,2.4vw,1.45rem);font-weight:800;color:var(--mg-ink-strong)}
    .pn-p{display:block;color:var(--mg-ink-muted);font-size:.92rem;line-height:1.6;max-width:56ch}
    .pn-arrow{font-size:1.2rem;font-weight:800;color:var(--mg-link)}
    .pn-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,19rem),1fr));gap:1.5rem}
    .pn-group{background:var(--mg-surface-strong);border:1px solid var(--mg-border-strong);border-radius:1rem;padding:1.1rem 1.25rem}
    .pn-group-label{margin:0 0 .5rem;padding-bottom:.6rem;border-bottom:1px solid var(--mg-border);font-size:.7rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--mg-link)}
    .pn-doors{list-style:none;margin:0;padding:0}
    .pn-crumb a{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem;padding:.55rem 0;border-bottom:1px solid var(--mg-border);text-decoration:none}
    .pn-crumb:last-child a{border-bottom:0}
    .pn-trail{font-size:.9rem;font-weight:700;color:var(--mg-ink-strong)}
    .pn-door-arrow{flex:0 0 auto;font-weight:800;color:var(--mg-link)}
    .pn-crumb a:hover .pn-trail,.pn-crumb a:focus-visible .pn-trail{color:var(--mg-link)}
    .pn-hero-copy {
      padding: clamp(1.25rem, 5vw, 3.5rem);
      border: 1px solid var(--mg-border);
      border-radius: 1.5rem;
      background: linear-gradient(145deg, color-mix(in srgb, var(--mg-accent) 9%, var(--mg-surface-strong)), var(--mg-surface-strong));
    }
    .pn-actions a, .pn-crumb a {
      min-height: 44px;
      align-items: center;
    }
    .pn-actions .pn-text-link {
      display: inline-flex;
      gap: .5rem;
      border-bottom: 0;
      text-decoration: underline;
      text-underline-offset: .2em;
    }
    .pn-hero a:focus-visible, .pn-section a:focus-visible {
      outline: 2px solid var(--mg-link);
      outline-offset: 3px;
    }
    #care-options { scroll-margin-top: calc(var(--header-height, 5rem) + 1rem); }
    #care-options ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
      gap: .75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    #care-options li {
      padding: .75rem 1rem;
      border: 1px solid var(--mg-border);
      border-radius: .8rem;
      background: var(--mg-surface-strong);
    }
    #care-options a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--mg-link);
      font-weight: 700;
      text-underline-offset: .2em;
    }
    @media (max-width: 480px) {
      .pn-actions { align-items: stretch; flex-direction: column; gap: .5rem; }
      .pn-actions a { justify-content: center; }
    }
    @media(max-width:640px){.pn-row{grid-template-columns:auto minmax(0,1fr)}.pn-number{grid-row:1}.pn-icon{display:none}.pn-arrow{display:none}.pn-copy{grid-column:2}}
    @media(prefers-reduced-motion:reduce){.pn-row{transition:none;transform:none}}
  </style>
</Layout>
