  <script is:inline>
    // Progressive enhancement only: highlight the nearest section tab while scrolling.
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = Array.from(document.querySelectorAll('.mg-tab[href]'));
      if ('IntersectionObserver' in window && tabs.length) {
        const setActive = (id) => tabs.forEach((t) => t.classList.toggle('mg-tab--active', t.getAttribute('href') === '#' + id));
        const observer = new IntersectionObserver((entries) => {
          entries.filter((e) => e.isIntersecting).forEach((e) => setActive(e.target.id));
        }, { rootMargin: '-40% 0px -55% 0px' });
        ['patient-stream', 'academic-stream'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) observer.observe(el);
        });
      }

      // Fast-connect portal: patient / academic form tabs.
      const CLINIC_WHATSAPP = '919667863295';
      const formTabs = Array.from(document.querySelectorAll('[data-form-target]'));
      const panels = {
        'patient-form-container': document.getElementById('patient-form-container'),
        'academic-form-container': document.getElementById('academic-form-container'),
      };
      const showForm = (targetId) => {
        if (successBanner) successBanner.hidden = true;
        formTabs.forEach((btn) => {
          const isActive = btn.dataset.formTarget === targetId;
          btn.classList.toggle('mg-tab--active', isActive);
          btn.setAttribute('aria-pressed', String(isActive));
        });
        Object.entries(panels).forEach(([id, panel]) => {
          if (panel) {
            panel.hidden = id !== targetId;
            if (id === targetId) {
              const form = panel.querySelector('form');
              if (form) {
                form.hidden = false;
                const submit = form.querySelector('button[type="submit"]');
                if (submit) { submit.disabled = false; submit.removeAttribute('aria-busy'); submit.querySelector('span').textContent = 'Send enquiry via WhatsApp'; }
              }
            }
          }
        });
      };
      formTabs.forEach((btn) => btn.addEventListener('click', () => showForm(btn.dataset.formTarget)));
      document.querySelectorAll('.mg-switchbar__tabs a[href^="#"]').forEach((tab) => tab.addEventListener('click', (event) => {
        const target = document.getElementById(tab.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      }));

      // Submission: compose a WhatsApp enquiry (no data stored or sent elsewhere).
      const successBanner = document.getElementById('form-success-banner');
      document.querySelectorAll('[data-enquiry-kind="academic"]').forEach((link) => link.addEventListener('click', () => showForm('academic-form-container')));
      if (new URLSearchParams(location.search).get('enquiry') === 'training') showForm('academic-form-container');
      document.querySelectorAll('form[data-contact-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const submit = form.querySelector('button[type="submit"]');
          if (submit) { submit.disabled = true; submit.setAttribute('aria-busy', 'true'); submit.querySelector('span').textContent = 'Opening WhatsApp…'; }
          const kind = form.dataset.contactForm === 'academic' ? 'Training enquiry' : 'Appointment enquiry';
          const lines = Array.from(form.elements)
            .filter((el) => el.name && el.value && el.type !== 'submit')
            .map((el) => `${el.tagName === 'SELECT' ? el.selectedOptions[0].text : el.value}`);
          const message = encodeURIComponent(`${kind} (Mind Grace landing page)\n` + lines.join('\n'));
          window.open(`https://wa.me/${CLINIC_WHATSAPP}?text=${message}`, '_blank', 'noopener');
          form.reset();
          form.hidden = true;
          if (successBanner) {
            successBanner.hidden = false;
            successBanner.focus({ preventScroll: true });
            successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      });
    });
  </script>
</Layout>
