import BlueprintPage from '../components/BlueprintPage.astro';
const sections=[
  {title:'Psychiatrist, psychologist and counsellor: what is the difference?',paragraphs:['A psychiatrist is a medical doctor who evaluates mental-health concerns in the context of a person’s health and may discuss medication as part of care. A clinical psychologist provides psychological assessment and therapy within their professional training and scope. Counsellors and therapists may offer talk-based support according to their qualifications and area of practice. The title alone does not tell you whether a particular service fits your concern, so ask about the clinician’s role and experience.','In India, “doctor” can refer to different kinds of qualifications in everyday conversation. A medical degree and specialist medical training are distinct from an academic doctorate or a psychology qualification. A person with a doctorate in psychology is not automatically a medical doctor and cannot prescribe medication on that basis. A clinical psychologist’s role is different from that of a psychiatrist. Confirm an individual provider’s credentials and registration with the clinic or the relevant professional body rather than inferring them from a title.'],table:{caption:'Choose a starting point by the question you want help with',headers:['Patient goal','A useful first question'],rows:[['“I want to review a prescription or discuss medication.”','Ask about a psychiatry consultation and bring your current prescription if available.'],['“I want regular sessions to work through a concern.”','Ask about therapy, clinician availability, approach and session fees.'],['“I already see a clinician somewhere else.”','Ask whether the clinic offers a second opinion or transfer discussion and what records are useful.'],['“I am booking on behalf of a family member.”','Ask what can be coordinated by a caller and what requires the patient’s involvement or consent.'],['“I am unsure which option fits.”','Contact reception with a general routing question; a form does not need a detailed clinical history.']]}},
  {title:'Are psychologists doctors?',paragraphs:['Some psychologists hold academic doctoral degrees, while others hold different psychology qualifications. That does not make them medical doctors. In a clinical setting, psychologists may conduct psychological assessment and provide therapy within their training and scope; psychiatrists are medical doctors who can assess medical factors and discuss medication. Because professional titles and registration requirements can vary, check the individual clinician’s stated qualifications and registration rather than assuming all psychologists have the same credential.','A patient does not need to settle this distinction before asking for help. The practical question is what you want the appointment to do: medical evaluation, therapy, psychological testing, or support choosing among these. The clinic can explain who provides the service and how referrals or coordinated care work.'],links:[{label:'Meet the Mind Grace clinical team',href:'/doctors'}]},
  {title:'Which doctor should I consult for anxiety or depression?',paragraphs:['There is no single right answer for every person. A psychiatrist may be a useful starting point when you want a medical assessment, have questions about medication, or are experiencing changes that substantially affect daily functioning. Therapy may be a useful starting point when you want structured psychological support, help with coping or relationships, or space to understand a pattern over time. Some people use both forms of care.','If you are deciding about depression specifically, read the guide to <a href="/blog/pages/adult/psychiatrist-vs-psychologist-depression">psychiatry or psychology for depression</a>. For ongoing anxiety, the <a href="/anxiety-therapy-near-me">anxiety care page</a> explains local routes. Online information cannot decide which service is appropriate for an individual, but the clinic can help route a general enquiry. Ask whether you need medical assessment, psychological therapy, or help understanding both options; a clinician can explain the relevant role after hearing what is happening.'],links:[{label:'Psychiatry consultations',href:'/psychiatry'},{label:'Clinical psychology and therapy',href:'/therapy'}]},
  {title:'If I want a second opinion or I am booking for someone else',paragraphs:['If you already receive care, tell the clinic that you are asking about a second opinion or continuity discussion. Ask which records would be useful and whether the clinician can review them. Do not stop or change existing treatment while waiting for a routine appointment unless your current clinician advises you to do so.','When booking for a family member, reception can explain appointment logistics, but the patient’s participation, privacy and consent still matter. A family member may be able to help with contact or attend if the patient agrees; the clinician will explain what can be discussed and with whom. For a child, use the separate <a href="/aasha">Aasha pathway</a>.']},
  {title:'How to choose a practical first appointment',paragraphs:['Consider the question you want answered, the provider’s clearly stated role and qualifications, the service scope, fee and duration, location or online availability, and how follow-up is handled. Ask how the clinician will explain options and what happens if a different service appears more suitable. Search words such as “best” or “top” do not show whether a provider is right for your circumstances.','At Mind Grace, adult psychiatry is coordinated through the <a href="/psychiatry">psychiatry service</a>, while therapy information is on the <a href="/therapy">clinical psychology and therapy page</a>. Review <a href="/fees">fees</a>, read <a href="/process">what to expect</a>, and use <a href="/book">the appointment request page</a>. A request is not confirmed until the clinic agrees a date and time. Mind Grace is not an emergency service; use <a href="/emergency">urgent-help information</a> for immediate safety concerns.']}
];
