      In a crisis? Get immediate help. Call emergency services if in immediate danger. Visit our emergency page for 24/7 crisis support resources.
    </div>

<!-- MOBILE NAV OVERLAY -->
  <div class="mobile-nav-overlay" id="mobile-nav-overlay" hidden></div>
  <!-- MOBILE NAV PANEL - Simplified -->
  <nav class="mobile-nav-panel" id="mobile-nav-panel" aria-label="Mobile navigation" inert hidden>
    <div class="mobile-nav-header">
      <h2>Menu</h2>
