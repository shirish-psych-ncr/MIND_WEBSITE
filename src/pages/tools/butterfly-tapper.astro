<!-- MOBILE NAV OVERLAY -->

<!-- MOBILE NAV PANEL -->

<!-- Visual Layers -->
<div id="supernova"></div>
<canvas id="trail-canvas"></canvas>
<canvas id="ui-canvas"></canvas>

<!-- UI Elements -->
<button id="gear-btn" type="button" aria-label="Pause butterfly tapper" aria-pressed="false"><i data-lucide="settings" aria-hidden="true"></i></button>
<div class="status-overlay" role="status" aria-live="polite" aria-atomic="true">
    <div class="status-text" id="label">Tap Screen to Begin</div>
</div>

<!-- Interaction Cores -->
<main id="main-content" tabindex="-1">
<h1 class="tool-page-title">Butterfly tapping for a brief grounding pause</h1>
<div class="seo-answer"><strong>What this tool does:</strong> Butterfly tapping is a bilateral grounding exercise from Mind Grace Neuropsychiatric Clinic — cross your arms over your chest and alternate gentle taps on each shoulder to calm routine stress in about a minute.</div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/resources">Therapeutic Tools</a></li><li aria-current="page">Butterfly Tapper</li></ol></nav>

  <!-- Scroll Progress Bar -->
  <div class="scroll-progress" aria-hidden="true"><div class="progress"><div class="progress-bar" data-progress=""></div></div></div>

  <div class="tapper-container">
    <button type="button" id="L" class="core" aria-label="Tap left side"><span class="core-inner"></span></button>
    <button type="button" id="R" class="core" aria-label="Tap right side"><span class="core-inner"></span></button>
  </div>
</main>



