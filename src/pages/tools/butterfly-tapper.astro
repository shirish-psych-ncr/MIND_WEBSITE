  <div id="network-status" class="network-status" role="status" aria-live="polite" hidden><span class="network-status-message"></span></div>

  <!-- Skip Link -->
  <!-- EMERGENCY BANNER WITH MARQUEE -->
  


<!-- MOBILE NAV OVERLAY -->
  <div class="mobile-nav-overlay" id="mobile-nav-overlay" hidden></div>

  <!-- MOBILE NAV PANEL - Simplified -->
  <nav class="mobile-nav-panel" id="mobile-nav-panel" aria-label="Mobile navigation" inert hidden>
    <div class="mobile-nav-header">
      <h2>Menu</h2>
      <button type="button" class="close-mobile-menu" aria-label="Close menu">
        <i data-lucide="x" style="width:24px;height:24px" aria-hidden="true"></i>
      </button>
    </div>
    <div class="mobile-nav-content">
      <div class="mobile-nav-section">
        <div class="mobile-nav-section-title">Explore</div>
