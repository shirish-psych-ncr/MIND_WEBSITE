    <!-- HEADER -->

    <!-- MOBILE NAV OVERLAY -->

    <!-- MOBILE NAV PANEL -->

    <!-- MAIN CONTENT -->
    <main id="main-content" tabindex="-1">

      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Services</li></ol></nav>

      <!-- HERO SECTION -->
      <section class="hero services-hero" aria-labelledby="page-title">
        <div class="hero-content">
          <div class="hero-text">
            <span class="hero-badge">Adult care at Mind Grace · Child care at Aasha</span>
            <h1 id="page-title">Mental health care in Greater Noida</h1>

<div class="seo-answer"><strong>Direct answer:</strong> Mind Grace offers psychiatry, therapy, and psychological assessment for adults in Greater Noida. All child and family development care is provided through Aasha Early Intervention Centre.</div>
            <p class="hero-subtitle">Two clear routes: adult psychiatric care and therapy here, or child development support through Aasha — in clinic or online.</p>
            <div class="hero-buttons">
              <a href="/book" class="btn btn-primary">
                <i data-lucide="calendar" aria-hidden="true"></i>
                Book adult care
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ADULT SERVICES SECTION -->
      <section class="main-section service-overview" aria-labelledby="service-pathway-title">
        <div class="section-header">
          <h2 id="service-pathway-title">Choose a care pathway</h2>
          <p>Start with the kind of support you are looking for. You can explore details, fees, and visit information when you need them.</p>
        </div>
        <ul class="service-pathway-list">
          <li><a id="psychiatry" href="/psychiatry"><strong>Psychiatry for adults</strong><span>Consultations, medication reviews, and support for mood, anxiety, and other concerns</span></a></li>
          <li><a id="psychology" href="/therapy"><strong>Therapy and counselling</strong><span>Talk-based support for individuals, couples, and families</span></a><span id="counseling" class="service-anchor" aria-hidden="true"></span></li>
          <li><a id="speech-therapy" href="/child-development"><strong>Child and family support (Aasha)</strong><span>Developmental assessments, therapy, learning support, and parent guidance</span></a><span id="aba-therapy" class="service-anchor" aria-hidden="true"></span></li>
        </ul>
        <details class="service-extra">
          <summary>Explore assessments and concerns</summary>
          <p>For a focused question, browse <a href="/assessments">psychological assessments</a>, <a href="/conditions">conditions and concerns</a>, or <a href="/adhd-autism-assessment">ADHD and autism assessment</a>.</p>
        </details>
        <details class="service-extra">
          <summary>Plan a visit</summary>
          <p>Check <a href="/fees">fees</a>, <a href="/process">what to expect</a>, or <a href="/teleconsultation">online appointments</a>, then <a href="/book">request a consultation</a>.</p>
        </details>
      </section>
      <!-- CTA SECTION -->
      <section class="main-section section-blush" aria-labelledby="cta-title">
        <div class="content-narrow text-center">
          <h2 id="cta-title">Not sure which service fits?</h2>
          <p class="hero-subtitle">
            That is a completely normal place to start. Send us a short message and we will point you to the right pathway — no commitment needed.
          </p>
          <div class="hero-buttons">
            <a href="/contact" class="btn btn-primary">Ask where to start</a>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->

    




