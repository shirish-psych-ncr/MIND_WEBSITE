  <div id="network-status" class="network-status" role="status" aria-live="polite" hidden><span class="network-status-message"></span></div>

<link rel="dns-prefetch" href="">
  <script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://mindgracencr.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Page Not Found",
      "item": "https://mindgracencr.in/404.html"
    }
  ]
}</script>
  <link rel="icon" href="/assets/images/favicon.ico" type="image/x-icon">


  <!-- EMERGENCY BANNER WITH MARQUEE -->
