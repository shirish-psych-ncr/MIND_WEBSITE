    <!-- Header -->

    <main id="main-content" tabindex="-1">
      <div class="seo-answer"><strong>Direct answer:</strong> Dr. Anita Sharma is the consultant psychiatrist leading Mind Grace Neuropsychiatric Clinic in Greater Noida, treating depression, anxiety, bipolar disorder, schizophrenia, ADHD and related conditions across the lifespan.</div>
<nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Dr Anita Sharma</li></ol></nav>

      <!-- Hero Section -->
      <section class="hero hero-split">
        <div class="container hero-inner">
          <div class="hero-content">
            <span class="section-badge">Consultant Psychiatrist</span>
            <h1>Dr. Anita Sharma</h1>
            <p class="hero-lead">Consultant Psychiatrist at Mind Grace</p>
            <p class="hero-text">
              Dr. Sharma provides compassionate, evidence-based psychiatric care for adults and children.
              Use this page to understand her clinical role, then explore services and booking information
              for care at Mind Grace in Greater Noida.
            </p>
            <div class="cta-group">
              <a href="/book/" class="btn btn-primary btn-large">Book Consultation</a>
              <a href="/services/" class="btn btn-outline btn-large">View Services</a>
            </div>
          </div>
          <div class="hero-image" fetchpriority="high">
            <img loading="eager" decoding="async" src="/assets/images/dr-anita-sharma-personal-photo-768.webp" srcset="/assets/images/dr-anita-sharma-personal-photo-480.webp 480w, /assets/images/dr-anita-sharma-personal-photo-768.webp 768w, /assets/images/dr-anita-sharma-personal-photo-1200.webp 1200w" sizes="(max-width: 800px) 92vw, 400px" alt="Dr. Anita Sharma" class="hero-img" width="400" height="500">
          </div>
        </div>
      </section>

      <!-- Introduction Section -->
      <section class="section section-light">
        <div class="container content-narrow">
          <h2>About Dr. Sharma</h2>
          <p>Dr. Anita Sharma is a Consultant Psychiatrist at Mind Grace Neuropsychiatric Clinic in Greater Noida.</p>
          <p>Consultations consider each person’s concerns and care needs. Treatment discussions may include medication management, psychological support, and follow-up.</p>
          <p>
            At Mind Grace Neuropsychiatric Clinic, she leads a multidisciplinary team committed to reducing stigma and making
            mental healthcare accessible, confidential, and effective for all patients.
          </p>
        </div>
      </section>

      <!-- Expertise Grid -->
      <section class="section section-light">
        <div class="container">
          <h2 class="section-title">Areas of Expertise</h2>
          <div class="expertise-grid">
            <div class="expertise-tag">
              <i data-lucide="layers" class="icon" aria-hidden="true"></i>
              <span>Mood Disorders</span>
            </div>
            <div class="expertise-tag">
              <i data-lucide="clock" class="icon" aria-hidden="true"></i>
              <span>Anxiety &#x26; Stress</span>
            </div>
            <div class="expertise-tag">
              <i data-lucide="calendar" class="icon" aria-hidden="true"></i>
              <span>Adult ADHD</span>
            </div>
            <div class="expertise-tag">
              <i data-lucide="users" class="icon" aria-hidden="true"></i>
              <span>Child Development</span>
            </div>
            <div class="expertise-tag">
              <i data-lucide="heart" class="icon" aria-hidden="true"></i>
              <span>Sleep Disorders</span>
            </div>
            <div class="expertise-tag">
              <i data-lucide="heart" class="icon" aria-hidden="true"></i>
              </div>
              <h3>Whole Person Care</h3>
              <p>Treating the mind, body, and social context together for lasting wellness.</p>
            </div>
            <div class="feature-card">
              <div class="feature-icon">
                <i data-lucide="tablet" class="icon" aria-hidden="true"></i>
              </div>
              <h3>Your Privacy</h3>
              <p>Read our <a href="/privacy/">privacy notice</a> for information about how personal details are handled, or contact the clinic with questions.</p>
            </div>
          </div>

      </section>

      <!-- CTA Section -->
      <section class="section-cta">
        <div class="container section-cta-center">
          <h2>Ready to Start Your Journey?</h2>
          <p>Take the first step towards better mental health with a confidential consultation.</p>
          <div class="cta-group">
            <a href="/book/" class="btn btn-primary btn-large">Book Appointment</a>
            <a href="/contact/" class="btn btn-outline btn-large">Contact Us</a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
</Layout>
