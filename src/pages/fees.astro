      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Fees</li></ol></nav>


    <!-- HERO SECTION -->
    <section class="hero hero-small">
      <div class="hero-inner">
        <div class="hero-content">
          <span class="section-badge">Transparent Pricing</span>
          <h1>Fees, payments, and what your visit includes</h1>
          <p class="lead">
            This page explains the listed fees and payment options so you can plan
            a visit at Mind Grace in Greater Noida before requesting an appointment.
          </p>

<div class="seo-answer"><strong>Direct answer:</strong> A psychiatric consultation is &#8377;900 for 45 minutes. Therapy and counselling sessions are &#8377;1,000 for 45 minutes, while psychological assessments usually range from &#8377;1,500 to &#8377;8,000. At Aasha Early Intervention Center, occupational therapy, speech and language therapy, ABA, and special education are &#8377;700 per 45-minute session.</div>
        </div>
      </div>
    </section>

    <!-- PRICING TABLES SECTION -->
    <section class="section">
      <div class="shell">
        <div class="section-header">
          <h2>Consultation &#x26; Session Fees</h2>
          <p>Standard rates for all services as of 2026</p>
        </div>

        <!-- Machine-readable comparison table (AEO: structured data extraction) -->
        <div class="table-scroll" role="region" aria-label="Fee comparison table" tabindex="0">
          <table class="fee-comparison-table">
            <caption>Mind Grace Neuropsychiatric Clinic - consultation, therapy, and assessment fees (INR)</caption>
            <thead>
              <tr>
                <th scope="col">Service</th>
                <th scope="col">Fee (INR)</th>
                <th scope="col">Duration</th>
                <th scope="col">What is included</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Psychiatric Consultation</th>
                <td>₹900*</td>
                <td>45 minutes (extended as needed)</td>
                <td>Detailed evaluation, diagnosis, a personalised treatment plan, and medication management when needed with Dr Anita Sharma.</td>
              </tr>
              <tr>
                <th scope="row">Therapy &amp; Counselling</th>
                <td>₹1,000</td>
                <td>45 minutes</td>
                <td>Individual psychotherapy and counselling with trained therapists. If you need several sessions or the standard rate is difficult to manage, please talk with our reception team about the available options.</td>
              </tr>
              <tr>
                <th scope="row">Aasha Early Intervention Center</th>
                <td>₹700 per session</td>
                <td>45 minutes per session</td>
                <td>Occupational therapy, speech and language therapy, ABA, and special education cost ₹700 for a 45-minute session. If your child needs several sessions each week, please speak with our reception team.</td>
              </tr>
              <tr>
                <th scope="row">Psychological Assessments &amp; Testing</th>
                <td>₹1,500 to ₹8,000</td>
                <td>Varies by battery</td>
                <td>IQ testing, ADHD evaluation, autism spectrum assessment, personality inventories; quoted after initial screening based on complexity</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="fee-terms"><small>* Additional-time term: if a psychiatric consultation continues beyond 60 minutes, each additional 15 minutes costs ₹200. Please ask reception before your appointment if you would like us to explain this charge.</small></p>

        <div class="pricing-grid">
          <!-- Psychiatric Consultation -->
          <article class="price-card">
            <div class="price-header">
              <h3>Psychiatric Consultation</h3>
              <p class="price-subtitle">Assessment with Dr. Anita Sharma</p>
            </div>
            <div class="price-amount">
              <span class="currency">₹</span>
              <span class="amount">900*</span>
              <span class="price-period">/ 45 minutes</span>
            </div>
            <ul class="price-features">
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                45-minute comprehensive session
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                Detailed evaluation and diagnosis
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                Personalized treatment plan
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                Medication management if needed
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                A 45-minute consultation with time for a careful assessment
              </li>
            </ul>
            <div class="price-footer">
              <a href="/book" class="button button-primary button-full">Book Consultation</a>
            </div>
          </article>

          <!-- Therapy & Counselling -->
          <article class="price-card featured">
            <div class="price-badge">Most Popular</div>
            <div class="price-header">
              <h3>Therapy &amp; Counselling</h3>
              <p class="price-subtitle">Individual psychotherapy with trained therapists</p>
            </div>
            <div class="price-amount">
              <span class="currency">₹</span>
              <span class="amount">1,000</span>
              <span class="price-period">/ 45 minutes</span>
            </div>
            <ul class="price-features">
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                45-minute therapy or counselling session
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                CBT, supportive therapy, and counselling
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                Multiple sessions needed, or the standard rate is out of reach? Talk to us at reception
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                Mental health should be affordable by all
              </li>
            </ul>
            <div class="price-footer">
              <a href="/book" class="button button-primary button-full">Book Therapy</a>
            </div>
          </article>

          <!-- Aasha Early Intervention Center -->
          <article class="price-card">
            <div class="price-header">
              <h3>Aasha Early Intervention Center</h3>
              <p class="price-subtitle">Child development services wing</p>
            </div>
            <div class="price-amount">
              <span class="currency">₹</span>
              <span class="amount">700</span>
              <span class="price-period">/ 45-minute session</span>
            </div>
            <ul class="price-features">
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                Occupational therapy
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                Speech and language therapy
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                ABA (Applied Behaviour Analysis)
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                Special education
              </li>
              <li>
                <i data-lucide="check" class="icon icon-sm check-icon" aria-hidden="true"></i>
                ₹700 per 45-minute session of any service; need multiple sessions in a week? Talk to us at reception
              </li>
            </ul>
            <div class="price-footer">
              <a href="/book" class="button button-primary button-full">Book Aasha Session</a>
            </div>
          </article>
        </div>

        <!-- Assessment Services -->
        <div class="section-header" style="margin-top: 4rem;">
          <h2>Psychological Assessments &#x26; Testing</h2>
          <p>Comprehensive evaluations for accurate diagnosis</p>
        </div>

        <div class="notice-box notice-info">
          <i data-lucide="info" class="icon icon-lg" aria-hidden="true"></i>
          <div>
            <strong>Assessment fees vary based on scope</strong>
            <p style="margin-top: 0.5rem;">
              Psychological testing is quoted after an initial screening to determine the appropriate
              assessment battery. Common assessments include IQ testing, ADHD evaluation, autism spectrum
              assessment, and personality inventories. The typical range is ₹1,500 to ₹8,000, depending on complexity.
            </p>
          </div>
        </div>

        <!-- Affordability Note -->
        <div class="notice-box notice-info" style="margin-top: 2rem;">
          <i data-lucide="heart" class="icon icon-lg" aria-hidden="true"></i>
          <div>
            <strong>Mental health should be affordable by all</strong>
            <p style="margin-top: 0.5rem;">
              If multiple therapy or counselling sessions are required, or if you can't afford the standard
              rates, please come and talk to us at reception. We will discuss what may be possible. The same
              applies at the Aasha Early Intervention Center wing: if your child needs multiple sessions
              within a week (occupational therapy, speech and language therapy, ABA, or special education
              at ₹700 per 45-minute session), just speak to our team at reception about a plan that suits you.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PAYMENT OPTIONS SECTION -->
    <section class="section section-alt">
      <div class="shell">
        <div class="section-header">
          <h2>Payment Methods &#x26; Policies</h2>
          <p>Flexible payment options to suit your needs</p>
        </div>

        <div class="features-grid">
          <!-- Cash Payment -->
          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <i data-lucide="briefcase" class="icon icon-lg" aria-hidden="true"></i>
            </div>
            <h3>Cash Payment</h3>
            <p>Accepted at the clinic during your visit. Please carry exact change when possible.</p>
          </article>

          <!-- UPI Payment -->
          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <i data-lucide="smartphone" class="icon icon-lg" aria-hidden="true"></i>
            </div>
            <h3>UPI Payment</h3>
            <p>Scan QR code at clinic or use UPI ID. Instant confirmation and digital receipt.</p>
          </article>

          <!-- Bank Transfer -->
          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <i data-lucide="repeat" class="icon icon-lg" aria-hidden="true"></i>
            </div>
            <h3>NEFT / IMPS</h3>
            <p>Bank transfer details provided upon booking. Share transaction ID for confirmation.</p>
          </article>

          <!-- Invoice -->
          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <i data-lucide="file-text" class="icon icon-lg" aria-hidden="true"></i>
            </div>
            <h3>Detailed Invoices</h3>
            <p>Itemized receipts provided for insurance reimbursement or tax documentation.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- INSURANCE SECTION -->
    <section class="section">
      <div class="shell">
        <div class="section-header">
          <h2>Insurance &#x26; Reimbursement</h2>
          <p>Mental health coverage information</p>
        </div>

        <div class="notice-box notice-info">
          <i data-lucide="check-circle" class="icon icon-lg" aria-hidden="true"></i>
          <div>
            <strong>Mental Healthcare Act, 2017 Compliance</strong>
            <p style="margin-top: 0.5rem;">
              As per Indian law, mental health conditions must be covered by insurance providers
              just like physical health conditions. We provide detailed invoices and medical
              documentation to support your reimbursement claims.
            </p>
          </div>
        </div>

        <div class="services-grid" style="margin-top: 2rem;">
          <article class="service-card">
            <div class="service-icon">
              <i data-lucide="check-circle" class="icon icon-lg" aria-hidden="true"></i>
            </div>
            <h3>Government Insurance</h3>
            <p>CGHS, ECHS, and other government schemes accepted with proper documentation.</p>
          </article>

          <article class="service-card">
            <div class="service-icon">
              <i data-lucide="check-circle" class="icon icon-lg" aria-hidden="true"></i>
            </div>
            <h3>Private Insurance</h3>
            <p>Major providers including Star Health, HDFC Ergo, ICICI Lombard, and more.</p>
          </article>

          <article class="service-card">
            <div class="service-icon">
              <i data-lucide="check-circle" class="icon icon-lg" aria-hidden="true"></i>
            </div>
