      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Contact</li></ol></nav>


    <!-- HERO SECTION -->
    <section class="hero-section hero-small">
      <div class="hero-content">
        <p class="hero-eyebrow">Routine appointment questions</p>
        <h1>Contact Mind Grace in Greater Noida</h1>
        <p class="hero-lead">
          If you are planning a visit, asking a routine question, or ready to request an appointment,
          these contact options connect you with Mind Grace in Gamma II, Greater Noida.
        <div class="seo-answer"><strong>Direct answer:</strong> Contact Mind Grace Neuropsychiatric Clinic by phone or WhatsApp at +91-96678-63295, or visit the clinic at J123, Gamma II, Greater Noida. For routine appointment questions use the contact options on this page; for emergencies call 112 instead.</div>
        </p>
      </div>
    </section>

    <!-- EMERGENCY NOTICE -->
    <section class="section-padded bg-warning">
      <div class="container-narrow">
        <div class="alert alert-warning">
          <i data-lucide="alert-triangle" class="alert-icon" width="24" height="24" aria-hidden="true"></i>
          <div>
            <strong>Emergency Notice:</strong> For medical emergencies or crisis situations, call 112 immediately or go to the nearest hospital emergency room. This clinic does not provide emergency services.
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT INFO CARDS -->
    <section class="section-padded">
      <div class="container">
        <div class="contact-grid">

          <!-- Phone Card -->
          <div class="contact-card">
            <div class="contact-icon">
              <i data-lucide="mail" width="32" height="32" aria-hidden="true"></i>
            </div>
            <h3>Email</h3>
            <p class="contact-detail">
              <a href="mailto:contact@mindgracencr.in">contact@mindgracencr.in</a>
            </p>
            <p class="contact-meta">Routine appointment questions only. Do not email emergency details.</p>
            <a href="mailto:contact@mindgracencr.in" class="button-primary button-small">Send Email</a>
          </div>

          <!-- Address Card -->
          <div class="contact-card">
            <div class="contact-icon">
              <i data-lucide="clock" width="32" height="32" aria-hidden="true"></i>
            </div>
            <h3>Clinic Hours</h3>
            <p class="contact-detail">
              Monday to Saturday<br>
              10:00 AM – 4:00 PM<br>
              5:30 PM – 7:30 PM
            </p>
            <p class="contact-meta">Closed on Sundays</p>
            <a href="/book" class="button-outline button-small">Book Appointment</a>
          </div>

          <!-- Emergency Card -->
          <div class="contact-card contact-card-emergency">
            <div class="contact-icon">
              <i data-lucide="clipboard-check" width="32" height="32" aria-hidden="true"></i>
            </div>
            <h3>First-Visit Process</h3>
            <p>See what usually happens before, during, and after the first consultation.</p>
            <a href="/process" class="card-link">See the first-visit process <i data-lucide="arrow-right" aria-hidden="true"></i></a>


        </div>
      </div>
    </div></section>

    <!-- CTA SECTION -->
    <section class="section-padded bg-dark text-light">
      <div class="container-narrow text-center">
        <h2>Ready to Begin?</h2>
        <p class="lead">
          Choose the route that works for you. For urgent or emergency situations, use emergency services rather than these routine contact channels.
        </p>
        <div class="cta-group">
          <a href="/book" class="button-primary button-large">Request an appointment</a>
          <a href="tel:+9196678-63295" class="button-outline button-large">Call&nbsp;+91&nbsp;96678&nbsp;63295</a>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->

  <script>
    // Year update
    const yearEl = document.getElementById('year');
    if (yearEl) {
      yearEl.textContent = new Date().getFullYear();
    }

    // Form validation hook
    const contactForm = document.querySelector('.contact-form');
    if (contactForm) {
      contactForm.addEventListener('submit', function(e) {
        e.preventDefault();
        // Basic validation
        const requiredFields = this.querySelectorAll('[required]');
        let isValid = true;

        requiredFields.forEach(field => {
          if (!field.value.trim()) {
            isValid = false;
            field.classList.add('error');
          } else {
            field.classList.remove('error');
          }
        });

        if (isValid) {
          alert('Thank you for your message! We will respond within 24-48 hours.');
          this.reset();
        } else {
          alert('Please fill in all required fields.');
        }
      });
    }
  </script>
