    <!-- MOBILE NAV PANEL - Simplified -->

    <div class="progress"><div class="progress-bar" data-progress=""></div></div>

    <main id="main-content" tabindex="-1" class="section">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/blog">Blog</a></li><li aria-current="page">Adult Mental Health</li></ol></nav>

      <!-- HERO -->
      <div class="shell surface-dark panel">
        <p class="eyebrow gold">Start with what you're experiencing</p>

        <h1>
          Adult mental health guidance for real-life concerns
        </h1>

        <p class="lead">
          You do not need to know what to call it. Start with what feels familiar: overthinking, anxiety, sleep changes, focus problems, burnout, or panic. These guides can help you decide whether a self-guided pause or professional support fits next.
        </p>
        <div class="blog-answer"><strong>In short:</strong> Mind Grace Greater Noida’s adult mental health guides cover anxiety, overthinking, sleep, focus, burnout and panic — you do not need a diagnosis first; start with the article closest to what feels familiar.</div>

        <!-- QUICK SEARCH INTENT -->
        <div class="cta-row">
          <button type="button" class="button-ghost" data-filter-tag="overthinking">
            Overthinking
          </button>
          <button type="button" class="button-ghost" data-filter-tag="anxiety">
            Anxiety
          </button>
          <button type="button" class="button-ghost" data-filter-tag="sleep">
            Sleep
          </button>
          <button type="button" class="button-ghost" data-filter-tag="adhd">
            Focus / ADHD
          </button>
          <button type="button" class="button-ghost" data-filter-tag="burnout">
            Burnout
          </button>
          <button type="button" class="button-ghost" data-filter-tag="panic">
            Panic
          </button>
        </div>

        <!-- STATS (SOFTENED) -->
        <div class="three-col">
          <div class="kpi">
            <p class="kpi-title">Articles available</p>
            <p class="kpi-copy" data-total-posts="">0</p>
          </div>
          <div class="kpi">
            <p class="kpi-title">Topics covered</p>
            <p class="kpi-copy" data-total-tags="">0</p>
          </div>
          <div class="kpi">
            <p class="kpi-title">Updated regularly</p>
            <p class="kpi-copy">New + relevant reads each visit</p>
          </div>
        </div>
      </div>

      <!-- SYMPTOM GRID -->
      <div class="shell section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Start here</p>
            <h2>What feels closest to your situation?</h2>
          </div>
          <p class="notice">Tap a topic to filter articles instantly</p>
        </div>

        <div class="filter-grid" data-symptom-grid=""></div>
      </div>

      <!-- SMART CONTROLS -->
      <div class="shell section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Focused paths</p>
            <h2>Shortcuts based on common needs</h2>
          </div>
          <p class="notice" data-active-state="">Loading articles…</p>
        </div>

        <div class="filter-grid" data-discovery-controls=""></div>
        <div class="blog-search" role="search" aria-label="Search adult mental health guides">
          <label for="adult-blog-search">Search these guides</label>
          <div class="blog-search-row">
            <input id="adult-blog-search" name="q" data-blog-search type="search" placeholder="Try anxiety, sleep, ADHD, burnout…" autocomplete="off">
            <button type="button" class="filter-chip" data-clear-search hidden>Clear</button>
          </div>
          <p class="blog-search-status" data-search-state aria-live="polite">Search by a concern, topic, or phrase.</p>
        </div>
      </div>

      <!-- MAIN FEED -->
      <div class="shell section" id="guide-library">
        <div class="section-head">
          <div>
            <p class="eyebrow">Browse</p>
            <span id="anxiety" class="topic-anchor" aria-hidden="true"></span>
            <span id="sleep" class="topic-anchor" aria-hidden="true"></span>
            <span id="adhd" class="topic-anchor" aria-hidden="true"></span>
            <h2>Articles you can explore</h2>
          </div>
          <p class="notice">Mix of essential guides and useful reads</p>
        </div>

        <div class="discovery-grid" data-feed-grid=""></div>
      </div>

      <!-- PINNED -->
      <div class="shell section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Start here if unsure</p>
            <h2>Foundational reads</h2>
          </div>
          <p class="notice">Clear starting points for most people</p>
        </div>

        <div class="discovery-grid" data-pinned-grid=""></div>
      </div>

      <!-- CLUSTERS -->
      <div class="shell section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Explore deeper</p>
            <h2>Problem clusters</h2>
          </div>
          <p class="notice">Grouped reading paths</p>
        </div>

        <div class="filter-grid" data-cluster-grid=""></div>
      </div>

      <!-- BEGINNER -->
      <div class="shell section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Feeling overwhelmed?</p>
            <h2>Start with a clear first read</h2>
          </div>
            <p class="notice">Clear articles for a first step</p>
        </div>

        <div class="discovery-grid" data-beginner-grid=""></div>
      </div>

      <!-- LOOP -->
      <div class="shell section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Keep exploring</p>
            <h2>You might also relate to</h2>
          </div>
          <p class="notice">More helpful reads</p>
        </div>

        <div class="discovery-grid" data-loop-grid=""></div>
      </div>

      <!-- CTA -->
      <div class="shell section">
        <div class="surface-soft panel">
          <h2>Need clarity for your situation?</h2>

          <p class="lead">
            Articles can guide you. A consultation helps you apply it to your
            life.
          </p>

          <div class="cta-row">
            <a class="button-primary" href="/book">Book consultation</a>
            <a class="button-ghost" rel="nofollow noopener" href="https://wa.me/9196678-63295">Ask on WhatsApp</a>
          </div>
        </div>
      </div>
    </main>

    <script src="/assets/js/min/blog-config-adult.min.js?v=blog3" defer></script>
    <script src="/assets/js/min/blog-discovery.min.js?v=blog2" defer></script>

    



    <!-- MIND GRACE LIBRARY STACK -->
</Layout>
