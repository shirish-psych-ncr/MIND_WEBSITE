{
  "name": "mind-grace-ncr-site",
  "private": true,
  "scripts": {
    "lint:a11y": "node scripts/a11y_lint/structure_lint.cjs && node scripts/a11y_lint/contrast_direction.cjs && node scripts/a11y_lint/prose_lint.cjs && node scripts/a11y_lint/a11y_css_inject.cjs",
    "lint:html": "html-validate --config config/htmlvalidate.json offline.html",
    "lint:readability": "node scripts/run-python.mjs scripts/a11y_lint/readability_hyphenation.py",
    "report": "node scripts/run-python.mjs scripts/a11y_lint/summarize_report.py",
    "test": "node scripts/run-python.mjs -m unittest discover -s tests -v && node --test tests/worker-routing.test.mjs",
    "typecheck": "astro check",
    "check:syntax": "node scripts/check-js-syntax.mjs",
    "check:docs": "node scripts/check-markdown.mjs",
    "check": "npm run typecheck && npm run check:syntax && npm run check:docs && npm test && npm run lint:html && npm run build",
    "check:full": "npm run check",
    "build:ci": "npm run build",
    "build:min": "node scripts/rebuild_min_css.cjs && node scripts/rebuild_min_js.cjs",
    "audit:responsive": "node scripts/audit_accessibility.cjs",
    "audit:lighthouse": "node scripts/audit_lighthouse.cjs",
    "audit:console": "node scripts/browser-smoke.mjs",
    "clean": "node scripts/clean.mjs",
    "build:min:css": "node scripts/rebuild_min_css.cjs",
    "build:min:js": "node scripts/rebuild_min_js.cjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/run-python.mjs scripts/build_blog_index.py && node scripts/validate-structured-data.mjs && node scripts/validate-build.mjs",
    "preview": "astro preview",
    "validate": "node scripts/validate-build.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy --config wrangler.site.toml",
    "prebuild": "npm run build:min"
  },
  "dependencies": {
    "alex": "^11.0.1",
    "color-blind": "^0.1.3",
    "direction": "^2.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "html-validate": "^10.17.0",
    "i18next-scanner": "^4.6.0",
    "wcag-contrast": "^3.0.0",
    "web-vitals": "^6.2.2",
    "write-good": "^1.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "astro": "7.3.5",
    "playwright": "^1.57.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "4.143.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
