# ==============================================================================
# 1. GLOBAL DEFAULTS: Security, AI/LLM Indexing, and Modern Client Hints
# ==============================================================================
/*
  # --- AI, LLM & CRAWLER OPTIMIZATION ---
  # Explicitly allows AI bots (GPTBot, PerplexityBot, etc.) to index, 
  # follow links, and use large snippets/images for rich AI search results.
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

  # --- MODERN CLIENT HINTS ---
  # Proactively informs the server about client capabilities to serve 
  # perfectly optimized, responsive assets (e.g., exact image sizes, AVIF/WebP).
  Accept-CH: Sec-CH-UA, Sec-CH-UA-Mobile, Sec-CH-UA-Platform, Sec-CH-UA-Platform-Version, Sec-CH-Viewport-Width, DPR, Width, Viewport-Width
  Critical-CH: Sec-CH-UA, Sec-CH-UA-Mobile, Sec-CH-UA-Platform

  # --- ZERO-TRUST SECURITY ---
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: on

  # --- PERMISSIONS POLICY ---
  # Disables unnecessary browser features to reduce attack surface and improve privacy.
  # Note: 'interest-cohort' is deprecated; 'browsing-topics' is the modern replacement.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), browsing-topics=()

  # --- CROSS-ORIGIN POLICIES ---
  # 'same-origin-allow-popups' is MUCH safer than 'same-origin'. 
  # Strict 'same-origin' will break third-party embeds (YouTube, Maps, external images). 
  # This allows popups (like OAuth or GTM debug windows) while keeping the main window isolated.
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site

  # --- CONTENT SECURITY POLICY (CSP) ---
  # Strict but GTM/GA4-friendly CSP. 
  # NOTE: 'unsafe-inline' and 'unsafe-eval' are included because Google Tag Manager 
  # requires them to function without complex server-side nonce generation. 
  # For maximum security in the future, consider migrating to CSP nonces.
  # FIX: 'unsafe-eval' was misspelled as 'unsafe-e' (invalid token).
  # FIX: CSP sources must be SPACE-separated; the old comma-separated list made
  # every entry an invalid source expression, so all third-party scripts were blocked.
  # Allow-list now covers every third-party script actually used on the site:
  # GTM/gtag, Google Analytics, Cloudflare Zaraz, Ahrefs analytics, Amplitude CDN, jsDelivr (Splide).
  Content-Security-Policy: \
    default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.analytics.google.com https://*.googletagmanager.com https://region1.google-analytics.com https://*.google-analytics.com https://static.cloudflareinsights.com https://analytics.ahrefs.com https://cdn.amplitude.com https://cdn.jsdelivr.net; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; \
    font-src 'self' data: https://fonts.gstatic.com; \
    img-src 'self' data: blob: https:; \
    connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://region1.google-analytics.com https://*.googletagmanager.com https://cdn.amplitude.com https://api-js.mixpanel.com https://analytics.ahrefs.com https://*.zaraz.cloudflare.com; \
    frame-src 'self' https://*.googletagmanager.com https://www.googletagmanager.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://docs.google.com https://www.openstreetmap.org; \
    worker-src 'self' blob:; \
    manifest-src 'self'; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self' https://docs.google.com; \
    frame-ancestors 'none';

# ==============================================================================
# 2. HTML & DYNAMIC CONTENT: Freshness for Indexers + Speed for Users
# ==============================================================================
/
/*.html
  # Forces crawlers to check for fresh content, while serving cached versions 
  # instantly to users (0ms TTFB) while revalidating in the background.
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400
  Content-Type: text/html; charset=utf-8
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

/*.json
  # Manifests, structured data, and config files should be cached but revalidated.
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8

# ==============================================================================
# 3. STATIC ASSETS: Aggressive Caching for Performance & Crawl Budget
# ==============================================================================
/*.css
/*.js
/*.woff
/*.woff2
/*.ttf
/*.otf
/*.svg
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.avif
/*.ico
  # 1-year immutable caching. Saves massive crawl budget and server load.
  # CRITICAL: Ensure your build process appends hashes to filenames 
  # (e.g., style.a1b2c3.css) so updates are fetched immediately despite the long cache time.
  Cache-Control: public, max-age=31536000, immutable
  # Only use '*' if these assets are intentionally served to other domains (e.g., as a CDN). 
  # Otherwise, restrict to your own domain for better security.
  Access-Control-Allow-Origin: *

# ==============================================================================
# 4. CRITICAL BOT & CONFIG FILES: Ensure they are always accessible and fresh
# ==============================================================================
/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: all

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex

/favicon.ico
  Cache-Control: public, max-age=86400
  Content-Type: image/x-icon
